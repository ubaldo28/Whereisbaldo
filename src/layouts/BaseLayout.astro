---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonicalURL?: string;
}

const {
  title = 'Where Is Baldo? — A California Boy. One Hell of a Story.',
  description = 'A California boy with Mexican roots who moved to Scotland, lost everything, and started over. This is the honest version of what happened.',
  ogImage = '/og-image.jpg',
  ogType = 'website',
  canonicalURL = Astro.url.href,
} = Astro.props;

const siteName = 'Where Is Baldo?';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={`https://whereisbaldo.com${ogImage}`} />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@whereisbaldo" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`https://whereisbaldo.com${ogImage}`} />

  <!-- Author & Publisher -->
  <meta name="author" content="Ubaldo Figueroa" />
  <meta name="robots" content="index, follow" />

  <!-- PWA -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="apple-touch-icon" href="/icon-192.png" />
  <meta name="theme-color" content="#2C1810" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Where Is Baldo?" />

  <!-- Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" />

  <!-- RSS Feed -->
  <link rel="alternate" type="application/rss+xml" title="Where Is Baldo? — RSS Feed" href="/rss.xml" />

  <!-- JSON-LD: Website -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Where Is Baldo?",
    "url": "https://whereisbaldo.com",
    "description": "A California boy with Mexican roots who moved to Scotland, lost everything, and started over. Personal stories told honestly.",
    "author": {
      "@type": "Person",
      "name": "Ubaldo Figueroa",
      "alternateName": "Baldo",
      "nationality": "American",
      "url": "https://whereisbaldo.com/about"
    }
  }
  </script>

  <!-- Google AdSense (lazy-loaded) -->
  <meta name="google-adsense-account" content="ca-pub-7380718671497895" />
  <script>
    window.adsbygoogle = window.adsbygoogle || [];
    window.loadAdSense = function() {
      if (!window.adSenseLoaded) {
        const script = document.createElement('script');
        script.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7380718671497895';
        script.async = true;
        script.crossOrigin = 'anonymous';
        document.head.appendChild(script);
        window.adSenseLoaded = true;
      }
    };
    
    // Load AdSense after page interactive (3 second delay)
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        setTimeout(window.loadAdSense, 3000);
      });
    } else {
      setTimeout(window.loadAdSense, 3000);
    }
  </script>

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-BSDXJ1PRGL"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-BSDXJ1PRGL');
  </script>
  <slot name="head" />
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <!-- Webpushr -->
  <script>(function(w,d, s, id) {if(typeof(w.webpushr)!=='undefined') return;w.webpushr=w.webpushr||function(){(w.webpushr.q=w.webpushr.q||[]).push(arguments)};var js, fjs = d.getElementsByTagName(s)[0];js = d.createElement(s); js.id = id;js.async=1;js.src = "https://cdn.webpushr.com/app.min.js";fjs.parentNode.appendChild(js);}(window,document, 'script', 'webpushr-jssdk'));webpushr('setup',{'key':'BFcSY49Fbl0plbicUgFhjBGABH7GMM9k-zAVucp7y-JkNtavzHlmmTE6rGIaFbtmz8q3v8EVgwL_6mGJ8PT48AQ' });</script>
</body>
</html>
