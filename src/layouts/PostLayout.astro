---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  heroEmoji?: string;
  heroColor?: string;
  relatedPosts?: any[];
}

const { title, description, pubDate, tags = [], heroEmoji = '✈️', heroColor = '#4A2C10, #8B5E2E', relatedPosts = [] } = Astro.props;

// Calculate read time (assume 200 words per minute)
const slot = await Astro.slots.render('default');
const wordCount = slot.split(/\s+/).length;
const readTime = Math.ceil(wordCount / 200);

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
});
const isoDate = pubDate.toISOString();
const tagLabel = tags.length > 0 ? tags.join(' · ') : 'Travel';
const canonicalURL = Astro.url.href;
---
<BaseLayout
  title={`${title} — Where Is Baldo?`}
  description={description}
  ogType="article"
  canonicalURL={canonicalURL}
>
  <!-- Article JSON-LD -->
  <script type="application/ld+json" slot="head">
  {JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "datePublished": isoDate,
    "dateModified": isoDate,
    "author": {
      "@type": "Person",
      "name": "Ubaldo Figueroa",
      "alternateName": "Baldo",
      "url": "https://whereisbaldo.com/about"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Where Is Baldo?",
      "url": "https://whereisbaldo.com"
    },
    "url": canonicalURL,
    "keywords": tags.join(', ')
  })}
  </script>

  <div class="post-header">
    <span class="post-tag">{tagLabel}</span>
    <h1>{title}</h1>
    <p class="post-meta">
      <time datetime={isoDate}>{formattedDate}</time>
      &nbsp;·&nbsp; <span class="read-time">{readTime} min read</span>
      &nbsp;·&nbsp; By <a href="/about" style="color:var(--gold)">Baldo</a>
    </p>
  </div>

  <div class="post-body">
    <slot />
  </div>

  <!-- RELATED POSTS -->
  {relatedPosts.length > 0 && (
    <div class="related-posts">
      <p class="share-label">Read Next</p>
      <div class="related-grid">
        {relatedPosts.map(p => (
          <a href={`/blog/${p.slug}`} class="related-item">
            <span class="related-emoji">{p.data.heroEmoji}</span>
            <span class="related-title">{p.data.title}</span>
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- SHARE BUTTONS -->
  <div class="share-section">
    <p class="share-label">Share this story</p>
    <div class="share-buttons">
      <!-- Facebook -->
      <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonicalURL)}`} target="_blank" rel="noopener" title="Share on Facebook" style="display:inline-flex;width:44px;height:44px;border-radius:50%;background:#1877F2;align-items:center;justify-content:center;text-decoration:none;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="white"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
      </a>
      <!-- X / Twitter -->
      <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(canonicalURL)}&text=${encodeURIComponent(title)}`} target="_blank" rel="noopener" title="Share on X" style="display:inline-flex;width:44px;height:44px;border-radius:50%;background:#000;align-items:center;justify-content:center;text-decoration:none;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="white"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
      <!-- WhatsApp -->
      <a href={`https://wa.me/?text=${encodeURIComponent(title + ' — ' + canonicalURL)}`} target="_blank" rel="noopener" title="Share on WhatsApp" style="display:inline-flex;width:44px;height:44px;border-radius:50%;background:#25D366;align-items:center;justify-content:center;text-decoration:none;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
      </a>
      <!-- Copy Link -->
      <button title="Copy Link" onclick={`navigator.clipboard.writeText('${canonicalURL}').then(()=>{this.style.background='#4A2C10';setTimeout(()=>{this.style.background='#C4995A'},2000)})`} style="display:inline-flex;width:44px;height:44px;border-radius:50%;background:#C4995A;align-items:center;justify-content:center;border:none;cursor:pointer;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
      </button>
    </div>
  </div>

  <div class="post-footer">
    <p>— Baldo</p>
    <p>Instagram <strong>@ubaldofigueroa</strong> · TikTok <strong>@whereisbaldo</strong></p>
    <div style="display:flex; gap:12px; flex-wrap:wrap; justify-content:center; margin: 1rem 0;">
      <a href="/blog" class="btn-primary">← More Stories</a>
    </div>
  </div>
</BaseLayout>
