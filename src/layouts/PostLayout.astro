---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  heroEmoji?: string;
  heroColor?: string;
}

const { title, description, pubDate, tags = [], heroEmoji = '✈️', heroColor = '#4A2C10, #8B5E2E' } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
});
const isoDate = pubDate.toISOString();
const tagLabel = tags.length > 0 ? tags.join(' · ') : 'Travel';
const canonicalURL = Astro.url.href;
---
<BaseLayout
  title={`${title} — Where Is Baldo?`}
  description={description}
  ogType="article"
  canonicalURL={canonicalURL}
>
  <!-- Article JSON-LD -->
  <script type="application/ld+json" slot="head">
  {JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "datePublished": isoDate,
    "dateModified": isoDate,
    "author": {
      "@type": "Person",
      "name": "Ubaldo Figueroa",
      "alternateName": "Baldo",
      "url": "https://whereisbaldo.com/about"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Where Is Baldo?",
      "url": "https://whereisbaldo.com"
    },
    "url": canonicalURL,
    "keywords": tags.join(', ')
  })}
  </script>

  <div class="post-header">
    <span class="post-tag">{tagLabel}</span>
    <h1>{title}</h1>
    <p class="post-meta">
      <time datetime={isoDate}>{formattedDate}</time>
      &nbsp;·&nbsp; By <a href="/about" style="color:var(--gold)">Baldo</a>
    </p>
  </div>

  <div class="post-body">
    <slot />
  </div>

  <div class="post-footer">
    <p>— Baldo</p>
    <p>Follow along on Instagram and TikTok <strong>@whereisbaldo</strong></p>
    <a href="/blog" class="btn-primary">← More Stories</a>
  </div>
</BaseLayout>
