---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  heroEmoji?: string;
  heroColor?: string;
  relatedPosts?: any[];
}

const { title, description, pubDate, tags = [], heroEmoji = '✈️', heroColor = '#4A2C10, #8B5E2E', relatedPosts = [] } = Astro.props;

// Calculate read time (assume 200 words per minute)
const slot = await Astro.slots.render('default');
const wordCount = slot.split(/\s+/).length;
const readTime = Math.ceil(wordCount / 200);

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
});
const isoDate = pubDate.toISOString();
const tagLabel = tags.length > 0 ? tags.join(' · ') : 'Travel';
const canonicalURL = Astro.url.href;
---
<BaseLayout
  title={`${title} — Where Is Baldo?`}
  description={description}
  ogType="article"
  canonicalURL={canonicalURL}
>
  <!-- Article JSON-LD -->
  <script type="application/ld+json" slot="head">
  {JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "datePublished": isoDate,
    "dateModified": isoDate,
    "author": {
      "@type": "Person",
      "name": "Ubaldo Figueroa",
      "alternateName": "Baldo",
      "url": "https://whereisbaldo.com/about"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Where Is Baldo?",
      "url": "https://whereisbaldo.com"
    },
    "url": canonicalURL,
    "keywords": tags.join(', ')
  })}
  </script>

  <div class="post-header">
    <span class="post-tag">{tagLabel}</span>
    <h1>{title}</h1>
    <p class="post-meta">
      <time datetime={isoDate}>{formattedDate}</time>
      &nbsp;·&nbsp; <span class="read-time">{readTime} min read</span>
      &nbsp;·&nbsp; By <a href="/about" style="color:var(--gold)">Baldo</a>
    </p>
  </div>

  <div class="post-body">
    <slot />
  </div>

  <!-- RELATED POSTS -->
  {relatedPosts.length > 0 && (
    <div class="related-posts">
      <p class="share-label">Read Next</p>
      <div class="related-grid">
        {relatedPosts.map(p => (
          <a href={`/blog/${p.slug}`} class="related-item">
            <span class="related-emoji">{p.data.heroEmoji}</span>
            <span class="related-title">{p.data.title}</span>
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- SHARE BUTTONS -->
  <div class="share-section">
    <p class="share-label">Share this story</p>
    <div class="share-buttons">
      <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonicalURL)}`} target="_blank" rel="noopener" class="share-btn share-fb">Facebook</a>
      <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(canonicalURL)}&text=${encodeURIComponent(title)}`} target="_blank" rel="noopener" class="share-btn share-x">X / Twitter</a>
      <a href={`https://wa.me/?text=${encodeURIComponent(title + ' — ' + canonicalURL)}`} target="_blank" rel="noopener" class="share-btn share-wa">WhatsApp</a>
      <button class="share-btn share-copy" onclick={`navigator.clipboard.writeText('${canonicalURL}').then(()=>{this.textContent='Copied!';setTimeout(()=>{this.textContent='Copy Link'},2000)})`}>Copy Link</button>
    </div>
  </div>

  <div class="post-footer">
    <p>— Baldo</p>
    <p>Follow along on Instagram and TikTok <strong>@whereisbaldo</strong></p>
    <div style="display:flex; gap:12px; flex-wrap:wrap; justify-content:center; margin: 1rem 0;">
      <a href="/blog" class="btn-primary">← More Stories</a>
    </div>
  </div>
</BaseLayout>
