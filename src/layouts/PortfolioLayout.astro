---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonicalURL?: string;
}

const {
  title = 'Ubaldo Figueroa — Web Developer & Growth Hacker',
  description = 'Ubaldo Figueroa builds and ships full-stack sites end to end — design, code, deploy. Four live production sites, including an AI news platform that publishes itself. Available for freelance and full-time work.',
  ogImage = '/og/portfolio.png',
  ogType = 'website',
  canonicalURL = Astro.url.href,
} = Astro.props;

const siteName = 'Where Is Baldo?';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={`https://whereisbaldo.com${ogImage}`} />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@whereisbaldo" />
  <meta name="twitter:creator" content="@whereisbaldo" />
  <meta name="twitter:image:alt" content="Ubaldo Figueroa — full-stack developer" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`https://whereisbaldo.com${ogImage}`} />

  <!-- Author & Publisher -->
  <meta name="author" content="Ubaldo Figueroa" />
  <meta name="robots" content="index, follow" />

  <!-- PWA -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="apple-touch-icon" href="/icon-192.png" />
  <meta name="theme-color" content="#0a0a0a" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Where Is Baldo?" />

  <!-- RSS Feed -->
  <link rel="alternate" type="application/rss+xml" title="Where Is Baldo? — RSS Feed" href="/rss.xml" />

  <!-- JSON-LD: this page is a person's profile, not a generic website -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "url": canonicalURL,
    "name": title,
    "description": description,
    "isPartOf": { "@type": "WebSite", "name": siteName, "url": "https://whereisbaldo.com" },
    "mainEntity": {
      "@type": "Person",
      "name": "Ubaldo Figueroa",
      "alternateName": "Baldo",
      "jobTitle": "Full-Stack Developer & Growth Engineer",
      "url": "https://whereisbaldo.com/portfolio",
      "email": "mailto:hello@whereisbaldo.com",
      "knowsAbout": ["Astro", "JavaScript", "Node.js", "Cloudflare Pages", "Technical SEO", "AI automation"],
      "sameAs": ["https://whereisbaldo.com", "https://potuswatchdaily.com"],
      "seeks": { "@type": "Demand", "name": "Freelance and full-time web development work" }
    }
  })} />

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-BSDXJ1PRGL"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-BSDXJ1PRGL');
  </script>
</head>
<body style="background: #0a0a0a; margin: 0; padding: 0;">
  <main style="padding: 0; margin: 0;">
    <slot />
  </main>
</body>
</html>
