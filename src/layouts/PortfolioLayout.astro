---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonicalURL?: string;
}

const {
  title = 'Ubaldo Figueroa — Web Developer & Growth Hacker',
  description = 'Three live sites. One year. No prior experience.',
  ogImage = '/og-image.jpg',
  ogType = 'website',
  canonicalURL = Astro.url.href,
} = Astro.props;

const siteName = 'Where Is Baldo?';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={`https://whereisbaldo.com${ogImage}`} />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@whereisbaldo" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`https://whereisbaldo.com${ogImage}`} />

  <!-- Author & Publisher -->
  <meta name="author" content="Ubaldo Figueroa" />
  <meta name="robots" content="index, follow" />

  <!-- PWA -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="apple-touch-icon" href="/icon-192.png" />
  <meta name="theme-color" content="#151515" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Where Is Baldo?" />

  <!-- Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" />

  <!-- RSS Feed -->
  <link rel="alternate" type="application/rss+xml" title="Where Is Baldo? — RSS Feed" href="/rss.xml" />

  <!-- JSON-LD: Website -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Where Is Baldo?",
    "url": "https://whereisbaldo.com",
    "description": "Web Developer & Growth Hacker. Three live sites. One year. No prior experience.",
    "author": {
      "@type": "Person",
      "name": "Ubaldo Figueroa",
      "alternateName": "Baldo",
      "nationality": "American",
      "url": "https://whereisbaldo.com/about"
    }
  }
  </script>

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-BSDXJ1PRGL"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-BSDXJ1PRGL');
  </script>
</head>
<body style="background: #151515; margin: 0; padding: 0;">
  <main style="padding: 0; margin: 0;">
    <slot />
  </main>
</body>
</html>
