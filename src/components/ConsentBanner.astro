---
// Google Analytics and Webpushr stay unloaded until the visitor accepts. The
// choice is remembered in localStorage; declining loads nothing. The footer's
// "Cookie settings" button reopens the banner so the choice can be changed.
const GA_ID = 'G-BSDXJ1PRGL';
const PUSH_KEY = 'BFcSY49Fbl0plbicUgFhjBGABH7GMM9k-zAVucp7y-JkNtavzHlmmTE6rGIaFbtmz8q3v8EVgwL_6mGJ8PT48AQ';
---
<div id="consent-banner" role="dialog" aria-label="Cookie consent" hidden>
  <p>
    I'd like to use Google Analytics to see which stories get read, and Webpushr for
    new-story notifications. Both set cookies, so they only run if you say yes.
    <a href="/cookie-policy/">Cookie policy</a>
  </p>
  <div class="consent-actions">
    <button type="button" id="consent-decline">No thanks</button>
    <button type="button" id="consent-accept">Accept</button>
  </div>
</div>

<script define:vars={{ GA_ID, PUSH_KEY }}>
  (function () {
    var KEY = 'wib-consent';
    var banner = document.getElementById('consent-banner');

    function read() {
      try { return localStorage.getItem(KEY); } catch (e) { return null; }
    }
    function write(v) {
      try { localStorage.setItem(KEY, v); } catch (e) {}
    }
    function loadAnalytics() {
      if (window.__gaLoaded) return;
      window.__gaLoaded = true;
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', GA_ID);
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
      document.head.appendChild(s);
    }

    function loadPush() {
      if (window.__pushLoaded) return;
      window.__pushLoaded = true;
      (function (w, d, s, id) {
        if (typeof w.webpushr !== 'undefined') return;
        w.webpushr = w.webpushr || function () { (w.webpushr.q = w.webpushr.q || []).push(arguments); };
        var js, fjs = d.getElementsByTagName(s)[0];
        js = d.createElement(s); js.id = id; js.async = 1;
        js.src = 'https://cdn.webpushr.com/app.min.js';
        fjs.parentNode.appendChild(js);
      }(window, document, 'script', 'webpushr-jssdk'));
      window.webpushr('setup', { key: PUSH_KEY });
    }
    function stopAnalytics() {
      window['ga-disable-' + GA_ID] = true;
      document.cookie.split(';').forEach(function (c) {
        var name = c.split('=')[0].trim();
        if (name === '_ga' || name.indexOf('_ga_') === 0) {
          document.cookie = name + '=; Max-Age=0; path=/';
          document.cookie = name + '=; Max-Age=0; path=/; domain=' + location.hostname;
          document.cookie = name + '=; Max-Age=0; path=/; domain=.' + location.hostname.replace(/^www\./, '');
        }
      });
    }

    var choice = read();
    if (choice === 'granted') {
      loadAnalytics();
      loadPush();
    } else if (choice !== 'denied') {
      banner.hidden = false;
    }

    var settings = document.getElementById('cookie-settings');
    if (settings) settings.addEventListener('click', function () { banner.hidden = false; });

    document.getElementById('consent-accept').addEventListener('click', function () {
      write('granted');
      window['ga-disable-' + GA_ID] = false;
      banner.hidden = true;
      loadAnalytics();
      loadPush();
    });
    document.getElementById('consent-decline').addEventListener('click', function () {
      write('denied');
      banner.hidden = true;
      stopAnalytics();
    });
  })();
</script>

<style>
  #consent-banner {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: 16px;
    max-width: 560px;
    margin: 0 auto;
    z-index: 1000;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    padding: 16px 18px;
    background: var(--cream, #FFFAED);
    color: var(--text, #3A2010);
    border: 2px solid var(--orange, #E07830);
    border-radius: 12px;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.25);
    font-size: 15px;
    line-height: 1.45;
  }
  #consent-banner[hidden] { display: none; }
  #consent-banner p { margin: 0; flex: 1 1 260px; }
  .consent-actions { display: flex; gap: 10px; }
  .consent-actions button {
    font: inherit;
    font-weight: 600;
    padding: 9px 18px;
    border-radius: 8px;
    border: 2px solid var(--orange, #E07830);
    background: transparent;
    color: var(--text, #3A2010);
    cursor: pointer;
  }
  .consent-actions #consent-accept {
    background: var(--orange-ink, #B4530F);
    border-color: var(--orange-ink, #B4530F);
    color: #fff;
  }
</style>
