---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Message Sent — Where Is Baldo?" description="Your message was sent successfully.">
  <section style="text-align:center; padding: 6rem 2rem; max-width: 600px; margin: 0 auto;">
    <div style="font-size: 4rem; margin-bottom: 1rem;">✉️</div>
    <span class="section-label">Got it</span>
    <h1 style="font-size: clamp(2rem, 5vw, 3rem); margin: 0.5rem 0 1rem;">Message Sent</h1>
    <p style="color: var(--brown); font-size: 1.1rem; line-height: 1.7; margin-bottom: 2rem;">
      Thanks for reaching out. I read everything and I'll get back to you if it seems like a good fit.
    </p>
    <a href="/" class="btn-primary">← Back Home</a>
  </section>
</BaseLayout>
