---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Start Here — Where Is Baldo?" description="Your guide to Where Is Baldo? — who Baldo is, where to start, and what to expect from the stories.">
  <section style="text-align:center; padding: 6rem 2rem; max-width: 600px; margin: 0 auto;">
    <div style="font-size: 4rem; margin-bottom: 1rem;">🧭</div>
    <span class="section-label">Start Here</span>
    <h1 style="font-size: clamp(2rem, 5vw, 3rem); margin: 0.5rem 0 1rem;">First Time Here?</h1>
    <p style="color: var(--brown); font-size: 1.1rem; line-height: 1.7; margin-bottom: 2rem;">
      My name is Baldo. I'm a California boy who somehow ended up in 22 countries, a relationship that fell apart in Scotland, and a one-way ticket to Mexico. This blog is where I tell that story — all of it, honestly, in the order it happened.
    </p>
    <p style="color: var(--brown); font-size: 1rem; line-height: 1.6; margin-bottom: 2rem;">
      Start with story one. Everything else follows from there.
    </p>
    <a href="/blog" class="btn-primary">Read the Blog</a>
  </section>
</BaseLayout>
