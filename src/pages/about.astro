---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About — Where Is Baldo?" description="Who is Baldo? A California boy with Mexican roots who moved to Scotland, watched his life fall apart, and started over. The honest version.">
  <section style="text-align:center; padding: 6rem 2rem; max-width: 600px; margin: 0 auto;">
    <div style="font-size: 4rem; margin-bottom: 1rem;">✂️</div>
    <span class="section-label">About</span>
    <h1 style="font-size: clamp(2rem, 5vw, 3rem); margin: 0.5rem 0 1rem;">I'm Ubaldo. Everyone Calls Me Baldo.</h1>
    <p style="color: var(--brown); font-size: 1.1rem; line-height: 1.7; margin-bottom: 2rem;">
      California boy. Mexican family. Barber. 22 countries. A life that fell apart in Scotland and a one-way ticket to Mexico. This blog is the honest version of all of it.
    </p>
    <p style="color: var(--brown); font-size: 1rem; line-height: 1.6; margin-bottom: 2rem;">
      Start with Story 1. Everything else follows from there.
    </p>
    <a href="/blog" class="btn-primary">Read the Stories →</a>
  </section>
</BaseLayout>
