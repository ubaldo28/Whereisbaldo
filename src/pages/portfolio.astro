---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
---
<PortfolioLayout title="Ubaldo Figueroa — Web Developer & Growth Hacker" description="Three live sites. One year. No prior experience.">

<!-- ── PORTFOLIO NAV ── -->
<nav class="pf-nav">
  <a href="/" class="pf-logo">UF</a>
  <div class="pf-links">
    <a href="#work">Work</a>
    <a href="#services">Services</a>
    <a href="/contact">Contact</a>
    <a href="/Ubaldo_Resume.docx" download class="pf-cv">Download CV ↓</a>
  </div>
</nav>

<!-- ── HERO ── -->
<section class="pf-hero">
  <!-- Background photo — full bleed, heavily blended -->
  <div class="pf-hero-bg">
    <img src="/baldo-headshot.png" alt="" aria-hidden="true" />
    <div class="pf-hero-overlay"></div>
  </div>
  <!-- Text sits on top -->
  <div class="pf-hero-text">
    <div class="pf-available"><span class="pf-dot"></span>Available for work</div>
    <h1 class="pf-h1">
      Hey, I'm<br/>
      <span class="pf-accent">Ubaldo Figueroa</span>
    </h1>
    <p class="pf-role">a web developer & growth hacker</p>
    <p class="pf-desc">Self-taught. Three live sites. One year.<br/>Built for real businesses, from scratch.</p>
    <p class="pf-typed"><span class="pf-hash">#</span> I build <span id="pf-tw"></span></p>
    <div class="pf-btns">
      <a href="/contact" class="pf-btn">Hire Me →</a>
      <a href="/Ubaldo_Resume.docx" download class="pf-btn-ghost">Download CV ↓</a>
    </div>
  </div>
</section>

<!-- ── CAPABILITIES ── -->
<div class="pf-about">
  <!-- Left: 3 capability cards -->
  <div class="pf-caps">
    <div class="pf-cap">
      <span class="pf-cap-num">01 / What I build</span>
      <h3 class="pf-cap-title">Full-Stack<br/>Web Dev</h3>
      <p class="pf-cap-desc">Design, code, launch — no handoffs, no agency overhead. One person who owns the whole thing.</p>
      <div class="pf-cap-tags"><span>Astro</span><span>JavaScript</span><span>HTML/CSS</span></div>
    </div>
    <div class="pf-cap">
      <span class="pf-cap-num">02 / How I grow it</span>
      <h3 class="pf-cap-title">SEO &<br/>Organic Growth</h3>
      <p class="pf-cap-desc">Sites engineered to rank. Technical SEO, conversion strategy, and on-page content — built in, not bolted on.</p>
      <div class="pf-cap-tags"><span>On-page SEO</span><span>Technical</span><span>Copy</span></div>
    </div>
    <div class="pf-cap">
      <span class="pf-cap-num">03 / What you get</span>
      <h3 class="pf-cap-title">Solo. Brief<br/>to Browser.</h3>
      <p class="pf-cap-desc">From your first message to a live URL — strategy, design, dev, and deploy. Faster and leaner than an agency.</p>
      <div class="pf-cap-tags"><span>End-to-end</span><span>Production-ready</span></div>
    </div>
  </div>

  <!-- Right: credentials + tech stack -->
  <div class="pf-cred-col">
    <div class="pf-cred-box">
      <p class="pf-cred-head">The case for hiring me</p>
      <div class="pf-cred-row">
        <span class="pf-dot-g"></span>
        <span><strong>3 production sites</strong> you can visit right now</span>
      </div>
      <div class="pf-cred-row">
        <span class="pf-dot-g"></span>
        <span><strong>1 paying client</strong> who trusted me first</span>
      </div>
      <div class="pf-cred-row">
        <span class="pf-dot-g"></span>
        <span>Went from <strong>zero to hire-ready</strong> in 12 months</span>
      </div>
      <div class="pf-cred-row pf-cred-muted">
        <span class="pf-dot-dim"></span>
        <span>No bootcamp. No agency. No shortcuts.</span>
      </div>
    </div>
    <div class="pf-stack-box">
      <p class="pf-stack-head">Tech stack</p>
      <div class="pf-stack-group">
        <p class="pf-stack-cat">Frontend</p>
        <div class="pf-pills"><span class="hi">Astro</span><span class="hi">JavaScript</span><span>HTML / CSS</span></div>
      </div>
      <div class="pf-stack-group">
        <p class="pf-stack-cat">Deploy & tooling</p>
        <div class="pf-pills"><span>Cloudflare Pages</span><span>Git / GitHub</span><span>Figma</span></div>
      </div>
      <div class="pf-stack-group">
        <p class="pf-stack-cat">Growth</p>
        <div class="pf-pills"><span class="hi">SEO</span><span>Analytics</span><span>Copywriting</span></div>
      </div>
    </div>
  </div>
</div>

<!-- ── WORK ── -->
<section class="pf-work" id="work">
  <p class="pf-label">Selected Work</p>

  <!-- 01 -->
  <div class="pf-project">
    <div class="pf-project-meta">
      <span class="pf-num">01</span>
      <span class="pf-tag">Freelance · 2026</span>
      <a href="https://geniotech.co.uk" target="_blank" rel="noopener" class="pf-link">geniotech.co.uk ↗</a>
    </div>
    <div class="pf-project-body">
      <div class="pf-browser">
        <div class="pf-browser-bar">
          <span class="bd r"></span><span class="bd y"></span><span class="bd g"></span>
          <span class="burl">geniotech.co.uk</span>
        </div>
        <video
          src="https://geniotech.co.uk/videos/hero.mp4"
          autoplay muted loop playsinline
          class="pf-project-video"
        ></video>
      </div>
      <div class="pf-project-info">
        <h2 class="pf-title">GenioTech</h2>
        <p class="pf-pdesc">A phone repair shop in Dundee needed a real web presence — not a template. Built solo: online booking, e-commerce, photo gallery, blog, newsletter, and a PWA customers can install.</p>
        <div class="pf-metrics">
          <div>🏆 Scottish Independent Retail Award Winner</div>
          <div>4.7★ · 200+ Verified Reviews</div>
        </div>
        <div class="pf-tags">
          <span>Booking System</span><span>E-commerce</span><span>PWA</span><span>SEO</span><span>Newsletter</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 02 -->
  <div class="pf-project">
    <div class="pf-project-meta">
      <span class="pf-num">02</span>
      <span class="pf-tag">Passion Project · January 2026</span>
      <a href="https://potuswatchdaily.com" target="_blank" rel="noopener" class="pf-link">potuswatchdaily.com ↗</a>
    </div>
    <div class="pf-project-body">
      <div class="pf-browser">
        <div class="pf-browser-bar">
          <span class="bd r"></span><span class="bd y"></span><span class="bd g"></span>
          <span class="burl">potuswatchdaily.com</span>
        </div>
        <a href="https://potuswatchdaily.com" target="_blank" rel="noopener">
          <img src="/portfolio-potus.jpg" alt="POTUS Watch Daily" />
        </a>
      </div>
      <div class="pf-project-info">
        <h2 class="pf-title">POTUS Watch Daily</h2>
        <p class="pf-pdesc">Started as practice. Became a real foreign policy intelligence platform publishing multiple dispatches every day — automated pipeline, breaking news ticker, AdSense, newsletter.</p>
        <div class="pf-metrics">
          <div>🔁 Publishes multiple times daily</div>
          <div>🔴 Live breaking news ticker</div>
          <div>💰 AdSense monetised</div>
        </div>
        <div class="pf-tags">
          <span>Automated Publishing</span><span>Breaking News</span><span>Newsletter</span><span>AdSense</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 03 -->
  <div class="pf-project pf-flip">
    <div class="pf-project-meta">
      <span class="pf-num">03</span>
      <span class="pf-tag">Personal Brand · March 2026</span>
      <a href="https://whereisbaldo.com" target="_blank" rel="noopener" class="pf-link">whereisbaldo.com ↗</a>
    </div>
    <div class="pf-project-body">
      <div class="pf-project-info">
        <h2 class="pf-title">Where Is Baldo?</h2>
        <p class="pf-pdesc">Built in a hotel room in Scotland, waiting on a government letter. Custom design, dark mode, email subscriptions, push notifications, Google Analytics, AdSense, and a full PWA.</p>
        <div class="pf-metrics">
          <div>🌍 Readers in multiple countries</div>
          <div>📲 Installable PWA</div>
          <div>📧 Email + push notifications</div>
        </div>
        <div class="pf-tags">
          <span>Custom Design</span><span>Dark Mode</span><span>Resend API</span><span>Webpushr</span><span>AdSense</span>
        </div>
      </div>
      <div class="pf-browser">
        <div class="pf-browser-bar">
          <span class="bd r"></span><span class="bd y"></span><span class="bd g"></span>
          <span class="burl">whereisbaldo.com</span>
        </div>
        <a href="https://whereisbaldo.com" target="_blank" rel="noopener">
          <img src="/portfolio-baldo.jpg" alt="Where Is Baldo?" />
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ── MARQUEE ── -->
<div class="pf-marquee">
  <div class="pf-marquee-track">
    <span>Web Design</span><span class="mx">✦</span>
    <span>AI Automation</span><span class="mx">✦</span>
    <span>SEO</span><span class="mx">✦</span>
    <span>Email Marketing</span><span class="mx">✦</span>
    <span>Growth Hacking</span><span class="mx">✦</span>
    <span>Chatbot Setup</span><span class="mx">✦</span>
    <span>Web Design</span><span class="mx">✦</span>
    <span>AI Automation</span><span class="mx">✦</span>
    <span>SEO</span><span class="mx">✦</span>
    <span>Email Marketing</span><span class="mx">✦</span>
    <span>Growth Hacking</span><span class="mx">✦</span>
    <span>Chatbot Setup</span><span class="mx">✦</span>
  </div>
</div>

<!-- ── SERVICES ── -->
<section class="pf-services" id="services">
  <p class="pf-label">What I Offer</p>
  <h2 class="pf-sec-title">Services</h2>
  <div class="pf-sgrid">
    <a href="/services" class="pf-scard">
      <span class="pf-sicon">💻</span>
      <h3>Web Design & Development</h3>
      <p>Custom sites from scratch. Fast, mobile-first, built to rank. Not templates.</p>
    </a>
    <a href="/services" class="pf-scard">
      <span class="pf-sicon">🤖</span>
      <h3>AI Automation</h3>
      <p>Systems that handle emails, workflows, and scheduling automatically.</p>
    </a>
    <a href="/services" class="pf-scard">
      <span class="pf-sicon">🔍</span>
      <h3>SEO</h3>
      <p>Technical and content SEO so the right people find you.</p>
    </a>
    <a href="/services" class="pf-scard">
      <span class="pf-sicon">📧</span>
      <h3>Email Marketing</h3>
      <p>Lists, sequences, newsletters, campaigns.</p>
    </a>
    <a href="/services" class="pf-scard">
      <span class="pf-sicon">📢</span>
      <h3>Paid Ads</h3>
      <p>Facebook, Instagram & Google ads done properly.</p>
    </a>
    <a href="/services" class="pf-scard">
      <span class="pf-sicon">💬</span>
      <h3>Chatbot Setup</h3>
      <p>AI bots that qualify leads and book 24/7.</p>
    </a>
  </div>
</section>

<!-- ── CTA ── -->
<section class="pf-cta">
  <p class="pf-label">Let's build something</p>
  <h2 class="pf-cta-title">Ready when<br/><em>you are.</em></h2>
  <p class="pf-cta-sub">Available for freelance and the right full-time role. You work with me directly — no agency, no handoffs.</p>
  <div class="pf-cta-btns">
    <a href="/contact" class="pf-btn">Get in Touch →</a>
    <a href="/Ubaldo_Resume.docx" download class="pf-btn-ghost">Download Resume</a>
  </div>
</section>

<!-- ── PORTFOLIO FOOTER ── -->
<div class="pf-foot">
  <span>© 2026 Ubaldo Figueroa</span>
  <a href="/">whereisbaldo.com</a>
</div>

<script>
const words = ["websites that rank.", "tools that automate.", "brands that grow.", "sites from scratch."];
let wi = 0, ci = 0, deleting = false;
const el = document.getElementById('pf-tw');
function type() {
  const word = words[wi];
  if (!deleting) {
    el.textContent = word.slice(0, ++ci);
    if (ci === word.length) { deleting = true; setTimeout(type, 1800); return; }
  } else {
    el.textContent = word.slice(0, --ci);
    if (ci === 0) { deleting = false; wi = (wi + 1) % words.length; }
  }
  setTimeout(type, deleting ? 50 : 80);
}
type();
</script>

</PortfolioLayout>

<style>
/* ── NAV ── */
.pf-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28px 60px;
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(21,21,21,0.9);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(255,255,255,0.05);
}
.pf-logo {
  font-size: 1rem;
  font-weight: 900;
  color: #fff;
  text-decoration: none;
  letter-spacing: 0.1em;
}
.pf-links {
  display: flex;
  align-items: center;
  gap: 2.5rem;
}
.pf-links a {
  text-decoration: none;
  color: rgba(255,255,255,0.55);
  font-size: 13px;
  font-weight: 500;
  letter-spacing: 0.05em;
  transition: color 0.2s;
}
.pf-links a:hover { color: #fff; }
.pf-cv {
  color: #fff !important;
  border: 1px solid rgba(255,255,255,0.2);
  padding: 8px 18px;
  border-radius: 6px;
  transition: background 0.2s !important;
}
.pf-cv:hover { background: rgba(255,255,255,0.08) !important; }

/* ── HERO ── */
.pf-hero {
  position: relative;
  min-height: 92vh;
  width: 100%;
  display: flex;
  align-items: center;
  overflow: hidden;
}

/* Photo: fills right portion, fully blended */
.pf-hero-bg {
  position: absolute;
  top: 0; right: 0;
  width: 65%;
  height: 100%;
  z-index: 0;
}
.pf-hero-bg img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center top;
  display: block;
  filter: brightness(0.65) contrast(1.1) grayscale(0.25);
}
/* Blend left edge and bottom into dark background */
.pf-hero-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(to right, #151515 0%, rgba(21,21,21,0.9) 25%, rgba(21,21,21,0.35) 55%, transparent 80%),
    linear-gradient(to top, #151515 0%, transparent 18%);
}

.pf-hero-text {
  position: relative;
  z-index: 2;
  padding: 0 0 0 80px;
  max-width: 620px;
}
.pf-available {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #4ade80;
  margin-bottom: 2rem;
}
.pf-dot {
  width: 8px; height: 8px;
  background: #4ade80;
  border-radius: 50%;
  animation: blink 2s infinite;
}
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.25} }

.pf-h1 {
  font-size: clamp(2.8rem, 5.5vw, 5rem);
  font-weight: 900;
  line-height: 1.05;
  color: #fff;
  margin: 0 0 0.75rem;
  letter-spacing: -0.02em;
}
.pf-accent { color: #c49959; }
.pf-role {
  font-size: 1.1rem;
  font-weight: 400;
  color: rgba(255,255,255,0.55);
  margin: 0 0 1.25rem;
}
.pf-typed {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.05em;
  color: rgba(255,255,255,0.4);
  margin: 0 0 2.5rem;
  font-family: monospace;
}
.pf-hash { color: #c49959; margin-right: 4px; }
#pf-tw {
  color: #4ade80;
  border-right: 2px solid #4ade80;
  padding-right: 2px;
  animation: blink-cursor 0.75s step-end infinite;
}
@keyframes blink-cursor { 0%,100%{border-color:#4ade80} 50%{border-color:transparent} }
.pf-desc {
  font-size: 1.05rem;
  line-height: 1.8;
  color: rgba(255,255,255,0.55);
  max-width: 480px;
  margin-bottom: 2.5rem;
}
.pf-btns { display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; }
.pf-btn {
  display: inline-block;
  background: #c49959;
  color: #151515;
  text-decoration: none;
  padding: 14px 28px;
  border-radius: 8px;
  font-weight: 700;
  font-size: 14px;
  letter-spacing: 0.03em;
  transition: opacity 0.2s;
}
.pf-btn:hover { opacity: 0.85; }
.pf-btn-ghost {
  display: inline-block;
  color: rgba(255,255,255,0.7);
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  border: 1px solid rgba(255,255,255,0.15);
  padding: 14px 28px;
  border-radius: 8px;
  transition: all 0.2s;
}
.pf-btn-ghost:hover { border-color: rgba(255,255,255,0.4); color: #fff; }

.pf-hero-img {
  position: relative;
  height: 88vh;
  overflow: visible;
}

/* ── CAPABILITIES ── */
.pf-about {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 16px;
  max-width: 1300px;
  margin: 0 auto;
  padding: 56px 60px;
  border-top: 1px solid rgba(255,255,255,0.06);
  border-bottom: 1px solid rgba(255,255,255,0.06);
}

/* Left: 3 capability cards stacked */
.pf-caps {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.pf-cap {
  background: #161616;
  border: 1px solid rgba(255,255,255,0.07);
  border-top: 2px solid #4ade80;
  border-radius: 10px;
  padding: 20px 22px 18px;
