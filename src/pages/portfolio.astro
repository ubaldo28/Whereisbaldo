<script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>
<script>
document.getElementById('pf-contact-form').addEventListener('submit', async function(e) {
  e.preventDefault();
  const btn = document.getElementById('pf-form-btn');
  const msg = document.getElementById('pf-form-msg');
  if (this.company.value) { return; }
  const token = (window.turnstile && document.querySelector('.cf-turnstile'))
    ? (this.querySelector('[name="cf-turnstile-response"]') || {}).value
    : undefined;
  const data = { name: this.name.value, email: this.email.value, message: this.message.value,
                 subject: 'Portfolio', 'cf-turnstile-response': token };
  btn.textContent = 'Sending...';
  btn.disabled = true;
  try {
    const res = await fetch('/api/contact', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });
    const json = await res.json();
    if (json.success) {
      msg.style.color = '#4ade80';
      msg.textContent = "Message sent. I'll be in touch soon.";
      this.reset();
    } else {
      msg.style.color = '#f87171';
      msg.textContent = json.error || 'Something went wrong. Try again.';
    }
  } catch {
    msg.style.color = '#f87171';
    msg.textContent = 'Something went wrong. Try again.';
  }
  btn.textContent = 'Send Message →';
  btn.disabled = false;
});

const words = ["websites that rank.", "tools that automate.", "brands that grow.", "sites from scratch."];
const el = document.getElementById('pf-tw');
const stillPlease = window.matchMedia('(prefers-reduced-motion: reduce)');

if (stillPlease.matches) {
  // WCAG 2.2.2 — no indefinite motion for people who ask for none.
  el.textContent = words[0];
} else {
  let wi = 0, ci = 0, deleting = false, timer = null;
  function type() {
    const word = words[wi];
    if (!deleting) {
      el.textContent = word.slice(0, ++ci);
      if (ci === word.length) { deleting = true; timer = setTimeout(type, 1800); return; }
    } else {
      el.textContent = word.slice(0, --ci);
      if (ci === 0) { deleting = false; wi = (wi + 1) % words.length; }
    }
    timer = setTimeout(type, deleting ? 50 : 80);
  }
  // Stop burning frames when the tab is in the background.
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) { clearTimeout(timer); } else { clearTimeout(timer); type(); }
  });
  type();
}

// The GenioTech clip is 2.3 MB. Don't fetch it until it is actually on screen,
// and never autoplay it for someone who asked for reduced motion.
const vid = document.getElementById('pf-gt-video');
if (vid && !stillPlease.matches && 'IntersectionObserver' in window) {
  const io = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) { if (!vid.paused) vid.pause(); return; }
      if (!vid.src) { vid.src = vid.dataset.src; }
      const p = vid.play();
      if (p) p.catch(() => {});
    });
  }, { rootMargin: '200px' });
  io.observe(vid);
}
</script>

