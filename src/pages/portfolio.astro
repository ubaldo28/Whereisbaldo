/* ── WORK ── */
.pf-work {
  max-width: 1300px;
  margin: 0 auto;
  padding: 100px 60px;
}
.pf-label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
