  font-weight: 400;
  color: rgba(255,255,255,0.55);
  margin: 0 0 1.25rem;
}
.pf-typed {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.05em;
  color: rgba(255,255,255,0.4);
  margin: 0 0 2.5rem;
  font-family: monospace;
}
.pf-hash {
  background: linear-gradient(135deg, #7c3aed, #06b6d4);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-right: 4px;
}
#pf-tw {
  color: #06b6d4;
  border-right: 2px solid #06b6d4;
  padding-right: 2px;
  animation: blink-cursor 0.75s step-end infinite;
}
@keyframes blink-cursor { 0%,100%{border-color:#06b6d4} 50%{border-color:transparent} }
.pf-desc {
  font-size: 1.05rem;
  line-height: 1.8;
  color: rgba(255,255,255,0.55);
  max-width: 480px;
  margin-bottom: 2.5rem;
}
.pf-btns { display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; }
.pf-btn {
  display: inline-block;
  background: linear-gradient(135deg, #7c3aed 0%, #06b6d4 100%);
  color: #fff;
  text-decoration: none;
  padding: 14px 28px;
  border-radius: 8px;
  font-weight: 700;
  font-size: 14px;
  letter-spacing: 0.03em;
  transition: all 0.25s;
  box-shadow: 0 0 28px rgba(124,58,237,0.45), 0 4px 15px rgba(0,0,0,0.4);
}
.pf-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 0 44px rgba(124,58,237,0.65), 0 8px 24px rgba(0,0,0,0.5);
}
.pf-btn-ghost {
  display: inline-block;
  color: rgba(255,255,255,0.7);
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  border: 1px solid rgba(124,58,237,0.35);
  padding: 14px 28px;
  border-radius: 8px;
  transition: all 0.2s;
}
.pf-btn-ghost:hover {
  border-color: rgba(124,58,237,0.7);
  color: #fff;
  background: rgba(124,58,237,0.1);
  box-shadow: 0 0 16px rgba(124,58,237,0.2);
}

/* ── TECH STRIP ── */
.pf-tech-strip {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.4rem 0;
  margin-top: 2.5rem;
  padding-top: 1.75rem;
  border-top: 1px solid rgba(124,58,237,0.18);
  max-width: 480px;
}
.pf-tech-strip span {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.28);
}
.pf-strip-dot {
  background: linear-gradient(135deg, #7c3aed, #06b6d4);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  padding: 0 0.5rem;
}

/* ── CAPABILITIES ── */
.pf-about {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 16px;
  max-width: 1300px;
  margin: 0 auto;
  padding: 56px 60px;
}
.pf-caps {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.pf-cap {
  background: #0c0c1a;
  border-radius: 10px;
  padding: 20px 22px 18px;
  flex: 1;
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(124,58,237,0.2);
  transition: border-color 0.3s, box-shadow 0.3s;
}
.pf-cap::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, #7c3aed, #06b6d4);
}
.pf-cap:hover {
  border-color: rgba(124,58,237,0.4);
  box-shadow: 0 0 30px rgba(124,58,237,0.12);
}
.pf-cap-num {
  display: block;
  font-size: 10px;
  font-family: monospace;
  background: linear-gradient(135deg, #7c3aed, #06b6d4);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: 0.08em;
  margin-bottom: 10px;
}
.pf-cap-title {
  font-size: 1.15rem;
  font-weight: 800;
  color: #fff;
  letter-spacing: -0.02em;
  line-height: 1.2;
  margin: 0 0 8px;
}
.pf-cap-desc {
  font-size: 12.5px;
  color: rgba(255,255,255,0.38);
  line-height: 1.65;
  margin: 0 0 14px;
}
.pf-cap-tags { display: flex; flex-wrap: wrap; gap: 5px; }
.pf-cap-tags span {
  font-size: 10px;
  font-family: monospace;
  color: rgba(124,58,237,0.8);
  background: rgba(124,58,237,0.08);
  border: 1px solid rgba(124,58,237,0.2);
  padding: 3px 8px;
  border-radius: 4px;
}

/* Right: credentials + tech stack */
.pf-cred-col { display: flex; flex-direction: column; gap: 12px; }
.pf-cred-box, .pf-stack-box {
  background: #0c0c1a;
  border: 1px solid rgba(124,58,237,0.18);
  border-radius: 10px;
  padding: 20px 22px;
}
.pf-cred-head, .pf-stack-head {
  font-size: 9.5px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.2);
  margin: 0 0 14px;
}
.pf-cred-row {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 9px 0;
  border-bottom: 1px solid rgba(255,255,255,0.05);
  font-size: 13px;
  color: rgba(255,255,255,0.65);
  line-height: 1.5;
}
.pf-cred-row:last-child { border-bottom: none; padding-bottom: 0; }
.pf-cred-row:first-of-type { padding-top: 0; }
.pf-cred-row strong { color: #fff; font-weight: 700; }
.pf-cred-muted { color: rgba(255,255,255,0.28) !important; font-style: italic; }
.pf-dot-g {
  width: 5px; height: 5px;
  border-radius: 50%;
  background: #4ade80;
  box-shadow: 0 0 6px rgba(74,222,128,0.6);
  flex-shrink: 0;
  margin-top: 6px;
}
.pf-dot-dim {
  width: 5px; height: 5px;
  border-radius: 50%;
  border: 1px solid rgba(255,255,255,0.15);
  flex-shrink: 0;
  margin-top: 6px;
}
.pf-stack-box { flex: 1; }
.pf-stack-group { margin-bottom: 12px; }
.pf-stack-group:last-child { margin-bottom: 0; }
.pf-stack-cat {
  font-size: 9px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.18);
  margin: 0 0 7px;
}
.pf-pills { display: flex; flex-wrap: wrap; gap: 5px; }
.pf-pills span {
  font-size: 11px;
  font-family: monospace;
  color: rgba(255,255,255,0.42);
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.08);
  padding: 3px 10px;
  border-radius: 100px;
}
.pf-pills span.hi {
  color: #a78bfa;
  border-color: rgba(124,58,237,0.35);
  background: rgba(124,58,237,0.1);
}

/* ── AVAILABLE BANNER ── */
.pf-avail-banner {
  border-top: 1px solid rgba(74,222,128,0.15);
  border-bottom: 1px solid rgba(74,222,128,0.15);
  background: rgba(74,222,128,0.04);
  padding: 18px 60px;
}
.pf-avail-inner {
  max-width: 1300px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 1rem;
}
.pf-avail-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: #4ade80;
  flex-shrink: 0;
  animation: blink 2s infinite;
  box-shadow: 0 0 8px rgba(74,222,128,0.7);
}
.pf-avail-text {
  font-size: 13px;
  font-weight: 500;
  color: rgba(255,255,255,0.55);
  flex: 1;
}
.pf-avail-cta {
  font-size: 12px;
  font-weight: 700;
  color: #4ade80;
  text-decoration: none;
  flex-shrink: 0;
  transition: opacity 0.2s;
}
.pf-avail-cta:hover { opacity: 0.7; }

/* ── SKILLS ── */
.pf-skills {
  padding: 80px 60px;
  border-top: 1px solid rgba(124,58,237,0.12);
  border-bottom: 1px solid rgba(124,58,237,0.12);
  background: linear-gradient(180deg, rgba(124,58,237,0.04) 0%, transparent 100%);
}
.pf-skills-inner {
  max-width: 1300px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1.6fr;
  gap: 60px;
  align-items: start;
}
.pf-skills-title {
  font-size: clamp(1.8rem, 3vw, 2.6rem);
  font-weight: 800;
  line-height: 1.15;
  color: #fff;
  margin-top: 12px;
}
.pf-skills-right {
  display: flex;
  flex-direction: column;
  gap: 20px;
  padding-top: 4px;
}
.pf-skill-item { display: flex; flex-direction: column; gap: 8px; }
.pf-skill-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.pf-skill-name {
  font-size: 13px;
  font-weight: 600;
  color: rgba(255,255,255,0.7);
}
.pf-skill-pct {
  font-size: 12px;
  font-weight: 700;
  font-family: monospace;
  background: linear-gradient(135deg, #7c3aed, #06b6d4);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.pf-skill-bar {
  height: 3px;
  background: rgba(255,255,255,0.06);
  border-radius: 2px;
  overflow: hidden;
}
.pf-skill-fill {
  height: 100%;
  background: linear-gradient(90deg, #7c3aed, #06b6d4);
  border-radius: 2px;
  box-shadow: 0 0 8px rgba(124,58,237,0.5);
}

/* ── SECTION LABELS ── */
.pf-label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  margin-bottom: 3rem;
  background: linear-gradient(135deg, #7c3aed, #06b6d4);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  display: inline-block;
}

/* ── WORK ── */
.pf-work {
  max-width: 1300px;
  margin: 0 auto;
  padding: 100px 60px;
}
.pf-work-title {
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: 900;
  color: #fff;
  line-height: 1;
  margin: 0 0 3rem;
  letter-spacing: -0.03em;
}
.pf-work-dot {
  background: linear-gradient(135deg, #7c3aed, #06b6d4);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.pf-project {
  padding: 70px 0;
  border-bottom: 1px solid rgba(124,58,237,0.12);
}
.pf-project-meta {
  display: flex;
  align-items: baseline;
  gap: 1.5rem;
  margin-bottom: 2rem;
}
.pf-num {
  font-size: clamp(3rem, 6vw, 5rem);
  font-weight: 900;
  background: linear-gradient(135deg, rgba(124,58,237,0.2), rgba(6,182,212,0.1));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height: 1;
  flex-shrink: 0;
  letter-spacing: -0.03em;
}
.pf-tag {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.3);
  flex: 1;
}
.pf-link {
  font-size: 13px;
  font-weight: 700;
  background: linear-gradient(135deg, #7c3aed, #06b6d4);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  text-decoration: none;
  flex-shrink: 0;
  transition: opacity 0.2s;
}
.pf-link:hover { opacity: 0.7; }
.pf-project-body {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 60px;
  align-items: start;
}
.pf-flip .pf-project-body { grid-template-columns: 1fr 1.2fr; }
.pf-flip .pf-project-meta { flex-direction: row-reverse; }
.pf-flip .pf-tag { text-align: right; }

/* Browser */
.pf-browser {
  border-radius: 10px;
  overflow: hidden;
  border: 1px solid rgba(124,58,237,0.2);
  box-shadow: 0 40px 100px rgba(0,0,0,0.7), 0 0 40px rgba(124,58,237,0.08);
  background: #0c0c1a;
  transition: box-shadow 0.3s;
}
.pf-browser:hover {
  box-shadow: 0 48px 120px rgba(0,0,0,0.8), 0 0 60px rgba(124,58,237,0.15);
}
.pf-browser-bar {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 10px 14px;
  background: #0a0a18;
  border-bottom: 1px solid rgba(124,58,237,0.1);
}
.bd { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
.bd.r { background: #ff5f57; }
.bd.y { background: #febc2e; }
.bd.g { background: #28c840; }
.burl {
  flex: 1;
  text-align: center;
  font-size: 11px;
  color: rgba(255,255,255,0.2);
  background: rgba(255,255,255,0.04);
  border-radius: 4px;
  padding: 3px 10px;
  margin: 0 6px;
}
.pf-browser img { width: 100%; display: block; transition: transform 0.5s; }
.pf-browser:hover img { transform: scale(1.02); }
.pf-browser-content { position: relative; overflow: hidden; line-height: 0; container-type: inline-size; aspect-ratio: 1318/896; }
.pf-browser-content img { height: 100%; }
.pf-vid-overlay {
  position: absolute;
  top: 10.6%; left: 0;
  width: 100%; height: 89%;
  object-fit: cover;
  display: block;
  transition: transform 0.5s;
}
.pf-browser:hover .pf-vid-overlay { transform: scale(1.02); }
.pf-gt-text {
  position: absolute;
  top: 29%; left: 0;
  width: 53%;
  padding-left: 4.5%;
  pointer-events: none;
  line-height: normal;
  font-family: -apple-system, "system-ui", "Segoe UI", Roboto, sans-serif;
}
.pf-hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 1.1cqw;
  color: rgb(93,202,165);
  background: rgba(29,158,117,0.12);
  border-radius: 20px;
  padding: 0.45cqw 1.3cqw;
  margin-bottom: 2cqw;
}
.pf-dot-closed {
  width: 0.55cqw; height: 0.55cqw;
  border-radius: 50%;
  background: rgb(93,202,165);
  flex-shrink: 0;
}
.pf-hero-h {
  font-size: 4.5cqw;
  font-weight: 500;
  color: #fff;
  line-height: 1.15;
  margin: 0 0 1.8cqw;
  letter-spacing: normal;
}
.pf-hero-green { color: rgb(93,202,165); font-style: normal; }
.pf-hero-p {
  font-size: 1.3cqw;
  color: rgba(255,255,255,0.75);
  line-height: 1.8;
  margin: 0 0 2.5cqw;
  font-weight: 400;
}
.pf-hero-btn {
  display: inline-block;
  padding: 0.8cqw 1.8cqw;
  background: rgb(29,158,117);
  color: #fff;
  font-size: 1.2cqw;
  font-weight: 500;
  border-radius: 7px;
  text-decoration: none;
  pointer-events: all;
}

/* Project info */
.pf-title {
  font-size: clamp(1.8rem, 3vw, 2.5rem);
  font-weight: 900;
  color: #fff;
  margin: 0 0 1rem;
  line-height: 1.1;
}
.pf-pdesc {
  font-size: 15px;
  line-height: 1.8;
  color: rgba(255,255,255,0.45);
  margin-bottom: 1.5rem;
}
.pf-metrics {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 1.5rem;
  padding: 16px 20px;
  background: rgba(124,58,237,0.06);
  border-left: 2px solid #7c3aed;
  border-radius: 0 8px 8px 0;
  font-size: 13px;
  color: rgba(255,255,255,0.5);
}
.pf-tags { display: flex; flex-wrap: wrap; gap: 6px; }
.pf-tags span {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.06em;
  padding: 4px 12px;
  border-radius: 20px;
  border: 1px solid rgba(124,58,237,0.25);
  color: rgba(167,139,250,0.7);
  background: rgba(124,58,237,0.06);
}
.pf-view-btn {
  display: inline-block;
  margin-top: 1.5rem;
  font-size: 13px;
  font-weight: 700;
  background: linear-gradient(135deg, #7c3aed, #06b6d4);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  text-decoration: none;
  border-bottom: 1px solid rgba(124,58,237,0.35);
  padding-bottom: 2px;
  transition: opacity 0.2s;
}
.pf-view-btn:hover { opacity: 0.75; }

/* ── MARQUEE ── */
.pf-marquee {
  overflow: hidden;
  border-top: 1px solid rgba(124,58,237,0.12);
  border-bottom: 1px solid rgba(124,58,237,0.12);
  padding: 20px 0;
  background: #05050c;
}
.pf-marquee-track {
  display: flex;
  align-items: center;
  gap: 2rem;
  width: max-content;
  animation: scroll 22s linear infinite;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.22);
}
.mx {
  background: linear-gradient(135deg, #7c3aed, #06b6d4);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
@keyframes scroll { from{transform:translateX(0)} to{transform:translateX(-50%)} }

/* ── SERVICES ── */
.pf-services {
  max-width: 1300px;
  margin: 0 auto;
  padding: 100px 60px;
}
.pf-sec-title {
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 900;
  color: #fff;
  margin: 0 0 3rem;
  line-height: 1;
}
.pf-sgrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: rgba(124,58,237,0.15);
  border-radius: 12px;
  overflow: hidden;
}
.pf-scard {
  background: #0a0a18;
  padding: 36px 30px;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  gap: 12px;
  transition: all 0.25s;
  position: relative;
  overflow: hidden;
}
.pf-scard::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(124,58,237,0.08), rgba(6,182,212,0.04));
  opacity: 0;
  transition: opacity 0.25s;
}
.pf-scard:hover { background: #0e0e20; }
.pf-scard:hover::before { opacity: 1; }
.pf-scard:hover { box-shadow: inset 0 0 30px rgba(124,58,237,0.08); }
.pf-sicon {
  font-size: 1.6rem;
  width: 48px; height: 48px;
  background: rgba(124,58,237,0.1);
  border: 1px solid rgba(124,58,237,0.2);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.pf-scard h3 {
  font-size: 1rem;
  font-weight: 700;
  color: #fff;
  margin: 0;
}
.pf-scard p {
  font-size: 13px;
  color: rgba(255,255,255,0.38);
  line-height: 1.65;
  margin: 0;
}

/* ── CONTACT ── */
.pf-contact {
  padding: 100px 60px;
  border-top: 1px solid rgba(124,58,237,0.12);
  background: linear-gradient(180deg, rgba(124,58,237,0.04) 0%, transparent 60%);
}
.pf-contact-inner {
  max-width: 1300px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 80px;
  align-items: start;
}
.pf-contact-left { padding-top: 4px; }
.pf-contact-cv { display: inline-block; margin-top: 2rem; }
.pf-cta-title {
  font-size: clamp(3rem, 6vw, 5rem);
  font-weight: 900;
  color: #fff;
  line-height: 1.05;
  margin: 0.5rem 0 1.25rem;
}
.pf-cta-title em {
  background: linear-gradient(135deg, #7c3aed, #06b6d4);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-style: italic;
}
.pf-cta-sub {
  font-size: 1rem;
  color: rgba(255,255,255,0.4);
  line-height: 1.75;
  max-width: 500px;
}
.pf-form { display: flex; flex-direction: column; gap: 20px; }
.pf-form-group { display: flex; flex-direction: column; gap: 8px; }
.pf-form-label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.3);
}
.pf-form-input {
  background: rgba(124,58,237,0.06);
  border: 1px solid rgba(124,58,237,0.2);
  border-radius: 8px;
  padding: 14px 16px;
  font-size: 14px;
  color: #fff;
  font-family: inherit;
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
  width: 100%;
}
.pf-form-input::placeholder { color: rgba(255,255,255,0.2); }
.pf-form-input:focus {
  border-color: rgba(124,58,237,0.6);
  box-shadow: 0 0 16px rgba(124,58,237,0.15);
