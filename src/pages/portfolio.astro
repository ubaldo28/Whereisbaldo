/* ── HERO ── */
.pf-hero {
  position: relative;
  min-height: 92vh;
  width: 100%;
  display: flex;
  align-items: flex-start;
  padding-top: 24px;
  overflow: hidden;
  background: #07070e;
}
/* Big purple-cyan glow behind photo */
.pf-hero::before {
  content: '';
  position: absolute;
  top: -20%;
  right: -5%;
  width: 80%;
  height: 140%;
  background:
    radial-gradient(ellipse 55% 65% at 70% 35%, rgba(124,58,237,0.22) 0%, transparent 65%),
    radial-gradient(ellipse 40% 50% at 90% 70%, rgba(6,182,212,0.14) 0%, transparent 60%);
  z-index: 0;
  pointer-events: none;
  animation: pulseGlow 6s ease-in-out infinite;
}
@keyframes pulseGlow {
  0%, 100% { opacity: 0.8; }
  50% { opacity: 1; }
}
.pf-hero-bg {
  position: absolute;
  top: 0; right: 0;
  width: 65%;
  height: 100%;
  z-index: 1;
}
.pf-hero-bg img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center top;
  display: block;
  filter: brightness(0.6) contrast(1.1) grayscale(0.2);
}
.pf-hero-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(to right, #07070e 0%, rgba(7,7,14,0.92) 25%, rgba(7,7,14,0.38) 55%, transparent 80%),
    linear-gradient(to top, #07070e 0%, transparent 8%);
}
.pf-hero-text {
  position: relative;
  z-index: 2;
  padding: 0 0 0 80px;
  max-width: 620px;
}
.pf-available {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #4ade80;
  margin-bottom: 2rem;
}
.pf-dot {
  width: 8px; height: 8px;
  background: #4ade80;
  border-radius: 50%;
  animation: blink 2s infinite;
  box-shadow: 0 0 8px rgba(74,222,128,0.7);
}
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.25} }

.pf-h1 {
  font-size: clamp(2.8rem, 5.5vw, 5rem);
  font-weight: 900;
  line-height: 1.05;
  color: #fff;
  margin: 0 0 0.75rem;
  letter-spacing: -0.02em;
}
/* Gradient name */
.pf-accent {
  background: linear-gradient(135deg, #7c3aed 0%, #06b6d4 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
