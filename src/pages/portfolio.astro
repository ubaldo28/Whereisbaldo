  color: #999;
  margin: 0 0 1rem;
  letter-spacing: 0.02em;
}
.pf-typed {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.05em;
  color: #ccc;
  margin: 0 0 2rem;
  font-family: monospace;
}
.pf-hash { color: #00918e; margin-right: 4px; }
#pf-tw {
  color: #0a0a0a;
  border-right: 2px solid #0a0a0a;
  padding-right: 2px;
  animation: blink-cursor 0.75s step-end infinite;
}
@keyframes blink-cursor { 0%,100%{border-color:#0a0a0a} 50%{border-color:transparent} }
.pf-desc {
  font-size: 1rem;
  line-height: 1.8;
  color: #777;
  max-width: 480px;
  margin-bottom: 2rem;
}
.pf-btns { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
.pf-btn {
  display: inline-block;
  background: #0a0a0a;
  color: #fff;
  text-decoration: none;
  padding: 13px 26px;
  font-weight: 700;
  font-size: 14px;
  letter-spacing: 0.02em;
  border: 2px solid #0a0a0a;
  transition: all 0.2s;
}
.pf-btn:hover { background: #fff; color: #0a0a0a; }
.pf-btn-ghost {
  display: inline-block;
  color: #0a0a0a;
  text-decoration: none;
  font-size: 14px;
  font-weight: 600;
  border: 2px solid #0a0a0a;
  padding: 13px 26px;
  background: transparent;
  transition: all 0.2s;
}
.pf-btn-ghost:hover { background: #0a0a0a; color: #fff; }

/* ── TECH STRIP ── */
.pf-tech-strip {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.4rem 0;
  margin-top: 2rem;
  padding-top: 1.5rem;
  border-top: 1px solid #e5e5e5;
  max-width: 480px;
}
.pf-tech-strip span {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #ccc;
}
.pf-strip-dot { color: #00918e; padding: 0 0.5rem; }

/* ── HERO STATS ── */
.pf-hero-stats {
  position: absolute;
  right: 64px;
  bottom: 64px;
  z-index: 3;
  display: flex;
  flex-direction: column;
  gap: 0;
  text-align: right;
}
.pf-stat { padding: 14px 0; }
.pf-stat-num {
  display: block;
  font-size: 3.8rem;
  font-weight: 900;
  color: #e8e8e8;
  line-height: 1;
  letter-spacing: -0.05em;
}
.pf-stat-label {
  display: block;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #ccc;
  margin-top: 2px;
}
.pf-stat-sep { width: 100%; height: 1px; background: #e5e5e5; }

/* ── CAPABILITIES ── */
.pf-about {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 16px;
  max-width: 1300px;
  margin: 0 auto;
  padding: 56px 60px;
  border-top: 4px solid #0a0a0a;
}
.pf-caps { display: flex; flex-direction: column; gap: 12px; }
.pf-cap {
  background: #fff;
  padding: 24px 24px 20px 28px;
  flex: 1;
  position: relative;
  border: 1.5px solid #e5e5e5;
  transition: border-color 0.2s;
}
.pf-cap::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 4px; height: 100%;
  background: #00918e;
}
.pf-cap:hover { border-color: #0a0a0a; }
.pf-cap-num {
  display: block;
  font-size: 10px;
  font-family: monospace;
  color: #00918e;
  letter-spacing: 0.08em;
  margin-bottom: 10px;
  font-weight: 700;
  text-transform: uppercase;
}
.pf-cap-title {
  font-size: 1.2rem;
  font-weight: 800;
  color: #0a0a0a;
  letter-spacing: -0.02em;
  line-height: 1.2;
  margin: 0 0 8px;
}
.pf-cap-desc {
  font-size: 13px;
  color: #888;
  line-height: 1.7;
  margin: 0 0 14px;
}
.pf-cap-tags { display: flex; flex-wrap: wrap; gap: 5px; }
.pf-cap-tags span {
  font-size: 10px;
  font-family: monospace;
  color: #555;
  background: #f5f5f5;
  border: 1px solid #e0e0e0;
  padding: 3px 8px;
  border-radius: 2px;
}

/* Credentials + stack */
.pf-cred-col { display: flex; flex-direction: column; gap: 12px; }
.pf-cred-box, .pf-stack-box {
  background: #fff;
  border: 1.5px solid #e5e5e5;
  padding: 22px;
}
.pf-cred-head, .pf-stack-head {
  font-size: 9.5px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #bbb;
  margin: 0 0 14px;
}
.pf-cred-row {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 9px 0;
  border-bottom: 1px solid #f0f0f0;
  font-size: 13px;
  color: #555;
  line-height: 1.5;
}
.pf-cred-row:last-child { border-bottom: none; padding-bottom: 0; }
.pf-cred-row:first-of-type { padding-top: 0; }
.pf-cred-row strong { color: #0a0a0a; font-weight: 700; }
.pf-cred-muted { color: #bbb !important; font-style: italic; }
.pf-dot-g {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: #16a34a;
  flex-shrink: 0;
  margin-top: 5px;
}
.pf-dot-dim {
  width: 6px; height: 6px;
  border-radius: 50%;
  border: 1px solid #ddd;
  flex-shrink: 0;
  margin-top: 5px;
}
.pf-stack-box { flex: 1; }
.pf-stack-group { margin-bottom: 14px; }
.pf-stack-group:last-child { margin-bottom: 0; }
.pf-stack-cat {
  font-size: 9px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #ccc;
  margin: 0 0 7px;
}
.pf-pills { display: flex; flex-wrap: wrap; gap: 5px; }
.pf-pills span {
  font-size: 11px;
  font-family: monospace;
  color: #888;
  background: #f5f5f5;
  border: 1px solid #e5e5e5;
  padding: 3px 10px;
  border-radius: 100px;
}
.pf-pills span.hi {
  color: #0a0a0a;
  border-color: #0a0a0a;
  background: #fff;
  font-weight: 700;
}

/* ── AVAILABLE BANNER ── */
.pf-avail-banner {
  background: #0a0a0a;
  padding: 18px 60px;
}
.pf-avail-inner {
  max-width: 1300px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 1rem;
}
.pf-avail-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: #4ade80;
  flex-shrink: 0;
  animation: blink 2s infinite;
  box-shadow: 0 0 8px rgba(74,222,128,0.7);
}
.pf-avail-text {
  font-size: 13px;
  font-weight: 500;
  color: rgba(255,255,255,0.5);
  flex: 1;
}
.pf-avail-cta {
  font-size: 12px;
  font-weight: 700;
  color: #fff;
  text-decoration: none;
  border-bottom: 1px solid rgba(255,255,255,0.35);
  padding-bottom: 1px;
  flex-shrink: 0;
  transition: opacity 0.2s;
}
.pf-avail-cta:hover { opacity: 0.7; }

/* ── SKILLS ── */
.pf-skills {
  padding: 80px 60px;
  border-top: 1px solid #e5e5e5;
  border-bottom: 1px solid #e5e5e5;
  background: #fafafa;
}
.pf-skills-inner {
  max-width: 1300px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1.6fr;
  gap: 60px;
  align-items: start;
}
.pf-skills-title {
  font-size: clamp(1.8rem, 3vw, 2.6rem);
  font-weight: 900;
  line-height: 1.1;
  color: #0a0a0a;
  margin-top: 12px;
  letter-spacing: -0.03em;
}
.pf-skills-right {
  display: flex;
  flex-direction: column;
  gap: 22px;
  padding-top: 4px;
}
.pf-skill-item { display: flex; flex-direction: column; gap: 8px; }
.pf-skill-top { display: flex; justify-content: space-between; align-items: center; }
.pf-skill-name { font-size: 13px; font-weight: 700; color: #0a0a0a; }
.pf-skill-pct { font-size: 12px; font-weight: 700; font-family: monospace; color: #00918e; }
.pf-skill-bar { height: 3px; background: #e5e5e5; overflow: hidden; }
.pf-skill-fill { height: 100%; background: #0a0a0a; }

/* ── SECTION LABELS ── */
.pf-label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  margin-bottom: 1rem;
  color: #00918e;
  display: inline-block;
}
.pf-label-inv { color: rgba(255,255,255,0.4) !important; }

/* ── WORK ── */
.pf-work {
  max-width: 1300px;
  margin: 0 auto;
  padding: 100px 60px;
}
.pf-work-title {
  font-size: clamp(3rem, 6vw, 5.5rem);
  font-weight: 900;
  color: #0a0a0a;
  line-height: 1;
  margin: 0 0 60px;
  letter-spacing: -0.05em;
}
.pf-work-dot { color: #00918e; }
.pf-project {
  padding: 70px 0;
  border-bottom: 1px solid #e5e5e5;
}
.pf-project-meta {
  display: flex;
  align-items: baseline;
  gap: 1.5rem;
  margin-bottom: 2rem;
}
.pf-num {
  font-size: clamp(3.5rem, 7vw, 6rem);
  font-weight: 900;
  color: #ebebeb;
  line-height: 1;
  flex-shrink: 0;
  letter-spacing: -0.04em;
}
.pf-tag {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #ccc;
  flex: 1;
}
.pf-link {
  font-size: 13px;
  font-weight: 700;
  color: #00918e;
  text-decoration: none;
  flex-shrink: 0;
  border-bottom: 1px solid rgba(0,145,142,0.35);
  padding-bottom: 1px;
  transition: opacity 0.2s;
}
.pf-link:hover { opacity: 0.7; }
.pf-project-body {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 60px;
  align-items: start;
}
.pf-flip .pf-project-body { grid-template-columns: 1fr 1.2fr; }
.pf-flip .pf-project-meta { flex-direction: row-reverse; }
.pf-flip .pf-tag { text-align: right; }

/* Browser */
.pf-browser {
  border-radius: 6px;
  overflow: hidden;
  border: 1px solid #e0e0e0;
  box-shadow: 0 20px 60px rgba(0,0,0,0.08), 0 4px 16px rgba(0,0,0,0.04);
  background: #f5f5f5;
  transition: box-shadow 0.3s;
}
.pf-browser:hover {
  box-shadow: 0 30px 80px rgba(0,0,0,0.12), 0 8px 24px rgba(0,0,0,0.06);
}
.pf-browser-bar {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 10px 14px;
  background: #1a1a1a;
  border-bottom: 1px solid #111;
}
.bd { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
.bd.r { background: #ff5f57; }
.bd.y { background: #febc2e; }
.bd.g { background: #28c840; }
.burl {
  flex: 1;
  text-align: center;
  font-size: 11px;
  color: rgba(255,255,255,0.2);
  background: rgba(255,255,255,0.06);
  border-radius: 4px;
  padding: 3px 10px;
  margin: 0 6px;
}
.pf-browser img { width: 100%; display: block; transition: transform 0.5s; }
.pf-browser:hover img { transform: scale(1.02); }
.pf-browser-content { position: relative; overflow: hidden; line-height: 0; container-type: inline-size; aspect-ratio: 1318/896; }
.pf-browser-content img { height: 100%; }
.pf-vid-overlay {
  position: absolute;
  top: 10.6%; left: 0;
  width: 100%; height: 89%;
  object-fit: cover;
  display: block;
  transition: transform 0.5s;
}
.pf-browser:hover .pf-vid-overlay { transform: scale(1.02); }
.pf-gt-text {
  position: absolute;
  top: 29%; left: 0;
  width: 53%;
  padding-left: 4.5%;
  pointer-events: none;
  line-height: normal;
  font-family: -apple-system, "system-ui", "Segoe UI", Roboto, sans-serif;
}
.pf-hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 1.1cqw;
  color: rgb(93,202,165);
  background: rgba(29,158,117,0.12);
  border-radius: 20px;
  padding: 0.45cqw 1.3cqw;
  margin-bottom: 2cqw;
}
.pf-dot-closed {
  width: 0.55cqw; height: 0.55cqw;
  border-radius: 50%;
  background: rgb(93,202,165);
  flex-shrink: 0;
}
.pf-hero-h {
  font-size: 4.5cqw;
  font-weight: 500;
  color: #fff;
  line-height: 1.15;
  margin: 0 0 1.8cqw;
  letter-spacing: normal;
}
.pf-hero-green { color: rgb(93,202,165); font-style: normal; }
.pf-hero-p {
  font-size: 1.3cqw;
  color: rgba(255,255,255,0.75);
  line-height: 1.8;
  margin: 0 0 2.5cqw;
  font-weight: 400;
}
.pf-hero-btn {
  display: inline-block;
  padding: 0.8cqw 1.8cqw;
  background: rgb(29,158,117);
  color: #fff;
  font-size: 1.2cqw;
  font-weight: 500;
  border-radius: 7px;
  text-decoration: none;
  pointer-events: all;
}

/* Project info */
.pf-title {
  font-size: clamp(2rem, 3.5vw, 3rem);
  font-weight: 900;
  color: #0a0a0a;
  margin: 0 0 1rem;
  line-height: 1;
  letter-spacing: -0.04em;
}
.pf-pdesc {
  font-size: 15px;
  line-height: 1.8;
  color: #666;
  margin-bottom: 1.5rem;
}
.pf-metrics {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 1.5rem;
  padding: 16px 20px;
  background: #fafafa;
  border-left: 3px solid #00918e;
  font-size: 13px;
  color: #555;
}
.pf-tags { display: flex; flex-wrap: wrap; gap: 6px; }
.pf-tags span {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.06em;
  padding: 4px 12px;
  border: 1px solid #e0e0e0;
  color: #888;
  background: #fff;
}
.pf-view-btn {
  display: inline-block;
  margin-top: 1.25rem;
  font-size: 13px;
  font-weight: 700;
  color: #0a0a0a;
  text-decoration: none;
  border-bottom: 2px solid #0a0a0a;
  padding-bottom: 2px;
  transition: color 0.2s, border-color 0.2s;
}
.pf-view-btn:hover { color: #00918e; border-color: #00918e; }

/* ── MARQUEE ── */
.pf-marquee {
  overflow: hidden;
  padding: 20px 0;
  background: #0a0a0a;
  border-top: 4px solid #00918e;
}
.pf-marquee-track {
  display: flex;
  align-items: center;
  gap: 2rem;
  width: max-content;
  animation: scroll 22s linear infinite;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.25);
}
.mx { color: #00918e; }
@keyframes scroll { from{transform:translateX(0)} to{transform:translateX(-50%)} }

/* ── SERVICES ── */
.pf-services {
  max-width: 1300px;
  margin: 0 auto;
  padding: 100px 60px;
}
.pf-sec-title {
  font-size: clamp(2.5rem, 5vw, 4.5rem);
  font-weight: 900;
  color: #0a0a0a;
  margin: 0 0 2.5rem;
  line-height: 1;
  letter-spacing: -0.05em;
}
.pf-sgrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: #e5e5e5;
  border: 1.5px solid #e5e5e5;
}
.pf-scard {
  background: #fff;
  padding: 36px 30px;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  gap: 10px;
  transition: background 0.2s;
}
.pf-scard:hover { background: #fafafa; }
.pf-scard:hover .pf-sicon { background: #00918e; }
.pf-sicon {
  font-size: 1.3rem;
  width: 44px; height: 44px;
  background: #0a0a0a;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 0.2s;
}
.pf-scard h3 {
  font-size: 1rem;
  font-weight: 800;
  color: #0a0a0a;
  margin: 0;
  letter-spacing: -0.01em;
}
.pf-scard p {
  font-size: 13px;
  color: #888;
  line-height: 1.65;
  margin: 0;
}

/* ── CONTACT ── */
.pf-contact {
  padding: 100px 60px;
  background: #0a0a0a;
}
.pf-contact-inner {
  max-width: 1300px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 80px;
  align-items: start;
}
.pf-contact-left { padding-top: 4px; }
.pf-contact-cv { display: inline-block; margin-top: 2rem; }
.pf-contact .pf-btn-ghost {
  color: rgba(255,255,255,0.6);
  border-color: rgba(255,255,255,0.25);
}
.pf-contact .pf-btn-ghost:hover {
  background: #fff;
  color: #0a0a0a;
  border-color: #fff;
}
.pf-cta-title {
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: 900;
  color: #fff;
  line-height: 1.05;
  margin: 0.5rem 0 1.25rem;
  letter-spacing: -0.04em;
}
.pf-cta-title em { color: #00918e; font-style: italic; }
.pf-cta-sub {
  font-size: 1rem;
  color: rgba(255,255,255,0.35);
  line-height: 1.75;
  max-width: 500px;
}
.pf-form { display: flex; flex-direction: column; gap: 20px; }
.pf-form-group { display: flex; flex-direction: column; gap: 8px; }
.pf-form-label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.3);
}
.pf-form-input {
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 0;
  padding: 14px 16px;
  font-size: 14px;
  color: #fff;
  font-family: inherit;
  outline: none;
  transition: border-color 0.2s;
  width: 100%;
}
.pf-form-input::placeholder { color: rgba(255,255,255,0.2); }
.pf-form-input:focus { border-color: #00918e; }
.pf-form-textarea { min-height: 140px; resize: vertical; }
.pf-form-submit {
  width: 100%;
  justify-content: center;
  cursor: pointer;
  font-family: inherit;
  font-size: 14px;
  background: #00918e;
  border: 2px solid #00918e;
  color: #fff;
  padding: 13px 26px;
  font-weight: 700;
  letter-spacing: 0.02em;
  transition: all 0.2s;
}
.pf-form-submit:hover { background: transparent; color: #00918e; }
.pf-form-submit:disabled { opacity: 0.6; cursor: default; }

/* ── FOOTER ── */
.pf-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 60px;
  background: #0a0a0a;
  border-top: 1px solid rgba(255,255,255,0.07);
  font-size: 12px;
  color: rgba(255,255,255,0.22);
}
.pf-foot a { color: rgba(255,255,255,0.22); text-decoration: none; transition: color 0.2s; }
.pf-foot a:hover { color: rgba(255,255,255,0.6); }
.pf-foot-sites {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 11px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.pf-foot-sep { color: rgba(255,255,255,0.12); }

/* ── RESPONSIVE ── */
@media (max-width: 960px) {
  .pf-work, .pf-services { padding: 60px 24px; }
  .pf-project-body, .pf-flip .pf-project-body { grid-template-columns: 1fr; gap: 28px; }
  .pf-flip .pf-project-body .pf-browser { order: -1; }
  .pf-sgrid { grid-template-columns: 1fr 1fr; }
  .pf-foot { padding: 20px 24px; }
  .pf-about { grid-template-columns: 1fr; padding: 36px 24px; gap: 16px; }
  .pf-contact { padding: 80px 24px; }
  .pf-skills { padding: 60px 24px; }
  .pf-avail-banner { padding: 18px 24px; }
  .pf-hero-stats { display: none; }
}
@media (max-width: 768px) {
  .pf-nav { padding: 16px 20px; }
  .pf-links a:not(.pf-cv) { display: none; }
  .pf-links { gap: 0; }
  .pf-hero { min-height: 88vh; padding-top: 18px; padding-bottom: 60px; }
  .pf-hero-bg { width: 55%; }
  .pf-hero-text { padding: 0 20px 40px 24px; max-width: 100%; }
  .pf-h1 { font-size: clamp(1.8rem, 8vw, 2.8rem); }
  .pf-name { font-size: clamp(2.2rem, 10vw, 3.5rem); }
