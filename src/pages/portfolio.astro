  font-weight: 400;
  color: rgba(255,255,255,0.4);
  margin: 0 0 1.5rem;
  letter-spacing: 0.01em;
}
.pf-desc {
  font-size: 1rem;
  line-height: 1.85;
  color: rgba(255,255,255,0.4);
  max-width: 460px;
  margin-bottom: 2.75rem;
}
.pf-btns { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
.pf-btn {
  display: inline-block;
  background: #ffffff;
  color: #080808;
  text-decoration: none;
  padding: 14px 28px;
  border-radius: 6px;
  font-weight: 700;
