<style>
/* ── NAV ── */
.pf-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 72px;
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(8,8,8,0.95);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(255,255,255,0.04);
}
.pf-logo {
  font-size: 0.8rem;
  font-weight: 900;
  color: #fff;
  text-decoration: none;
  letter-spacing: 0.15em;
}
.pf-links {
  display: flex;
  align-items: center;
  gap: 2.5rem;
}
.pf-links a {
  text-decoration: none;
  color: rgba(255,255,255,0.38);
  font-size: 13px;
  font-weight: 500;
  letter-spacing: 0.04em;
  transition: color 0.2s;
}
.pf-links a:hover { color: #fff; }
.pf-cv {
  color: rgba(255,255,255,0.7) !important;
  border: 1px solid rgba(255,255,255,0.12) !important;
  padding: 8px 18px;
  border-radius: 6px;
  transition: background 0.2s, border-color 0.2s, color 0.2s !important;
}
.pf-cv:hover {
  background: rgba(255,255,255,0.06) !important;
  border-color: rgba(255,255,255,0.3) !important;
  color: #fff !important;
}

/* ── HERO ── */
.pf-hero {
  position: relative;
  min-height: 92vh;
  width: 100%;
  display: flex;
  align-items: center;
  overflow: hidden;
}
.pf-hero-bg {
  position: absolute;
  top: 0; right: 0;
  width: 56%;
  height: 100%;
  z-index: 0;
}
.pf-hero-bg img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center top;
  display: block;
  filter: brightness(0.48) contrast(1.1) grayscale(0.4);
}
.pf-hero-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(to right, #080808 0%, rgba(8,8,8,0.96) 28%, rgba(8,8,8,0.55) 54%, transparent 78%),
    linear-gradient(to top, #080808 0%, transparent 10%);
}
.pf-hero-text {
  position: relative;
  z-index: 2;
  padding: 0 0 0 72px;
  max-width: 620px;
}
.pf-available {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #4ade80;
  margin-bottom: 2.25rem;
}
.pf-dot {
  width: 7px; height: 7px;
  background: #4ade80;
  border-radius: 50%;
  animation: blink 2s infinite;
}
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.25} }

.pf-h1 {
  font-size: clamp(4rem, 7.5vw, 7rem);
  font-weight: 900;
  line-height: 0.94;
  color: #fff;
  margin: 0 0 1.75rem;
  letter-spacing: -0.035em;
}
.pf-role {
