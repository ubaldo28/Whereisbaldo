---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Portfolio — Ubaldo Figueroa" description="Web developer. Three live sites. One year. No prior experience.">
<div class="portfolio-wrap">

<!-- HERO -->
<section class="hero">
  <div class="hero-right">
    <div class="hero-photo-wrap">
      <img src="/baldo-london-eye.jpg" alt="Ubaldo Figueroa" class="hero-photo" />
    </div>
  </div>
  <div class="hero-left">
    <div class="hero-available"><span class="pulse"></span>Available for work</div>
    <h1 class="hero-name">
      <span class="hero-name-first">UBALDO</span>
      <span class="hero-name-last">FIGUEROA</span>
    </h1>
    <p class="hero-role">Web Developer <span class="hero-amp">&</span> Growth Hacker</p>
    <p class="hero-desc">I build websites that work — fast, SEO-ready, and built to grow. Three live sites. One year. No prior experience. No excuses.</p>
    <div class="hero-btns">
      <a href="/contact" class="btn-primary">Let's Work →</a>
      <a href="/Ubaldo_Resume.docx" download class="hero-cv">Download CV ↓</a>
    </div>
  </div>
  <div class="hero-stats-bar">
    <div class="hstat"><span class="hstat-n">3</span><span class="hstat-l">Sites Built</span></div>
    <div class="hstat-line"></div>
    <div class="hstat"><span class="hstat-n">1</span><span class="hstat-l">Paying Client</span></div>
    <div class="hstat-line"></div>
    <div class="hstat"><span class="hstat-n">0</span><span class="hstat-l">Prior Experience</span></div>
  </div>
</section>

<!-- PROJECTS -->
<section class="projects">
  <div class="projects-label">SELECTED WORK</div>

  <!-- 01 -->
  <div class="project">
    <div class="project-header">
      <span class="project-num">01</span>
      <span class="project-type">Freelance Client Work · 2026</span>
      <a href="https://geniotech.co.uk" target="_blank" rel="noopener" class="project-url">geniotech.co.uk ↗</a>
    </div>
    <div class="project-body">
      <div class="project-browser">
        <div class="browser-bar">
          <span class="bdot r"></span><span class="bdot y"></span><span class="bdot g"></span>
          <span class="burl">geniotech.co.uk</span>
        </div>
        <a href="https://geniotech.co.uk" target="_blank" rel="noopener">
          <img src="/portfolio-geniotech.jpg" alt="GenioTech" />
        </a>
      </div>
      <div class="project-info">
        <h2 class="project-title">GenioTech</h2>
        <p class="project-desc">A phone repair shop in Dundee needed a real web presence — not a template. I built the entire thing solo: online booking, e-commerce, photo gallery, blog, newsletter, and a PWA customers can install on their phone.</p>
        <div class="project-metrics">
          <div class="metric"><strong>🏆</strong> Scottish Retail Award Winner</div>
          <div class="metric"><strong>4.6★</strong> · 184+ Google Reviews</div>
          <div class="metric"><strong>&lt;1hr</strong> most screen repairs</div>
        </div>
        <div class="project-stack">
          <span>Booking System</span><span>E-commerce</span><span>PWA</span><span>SEO</span><span>Newsletter</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 02 -->
  <div class="project project-flip">
    <div class="project-header">
      <span class="project-num">02</span>
      <span class="project-type">Personal Brand · March 2026</span>
      <a href="https://whereisbaldo.com" target="_blank" rel="noopener" class="project-url">whereisbaldo.com ↗</a>
    </div>
    <div class="project-body">
      <div class="project-info">
        <h2 class="project-title">Where Is Baldo?</h2>
        <p class="project-desc">Built while living in a hotel room in Scotland, waiting on a government letter. No team. No plan. Custom design, dark mode, email subscriptions, push notifications, AdSense, and an installable PWA. You're on it right now.</p>
        <div class="project-metrics">
          <div class="metric"><strong>🌍</strong> 17 countries reached</div>
          <div class="metric"><strong>📲</strong> Installable PWA</div>
          <div class="metric"><strong>📧</strong> Email + push notifications</div>
        </div>
        <div class="project-stack">
          <span>Custom Design</span><span>Dark Mode</span><span>Resend API</span><span>Webpushr</span><span>AdSense</span><span>PWA</span>
        </div>
      </div>
      <div class="project-browser">
        <div class="browser-bar">
          <span class="bdot r"></span><span class="bdot y"></span><span class="bdot g"></span>
          <span class="burl">whereisbaldo.com</span>
        </div>
        <a href="https://whereisbaldo.com" target="_blank" rel="noopener">
          <img src="/portfolio-baldo.jpg" alt="Where Is Baldo?" />
        </a>
      </div>
    </div>
  </div>

  <!-- 03 -->
  <div class="project">
    <div class="project-header">
      <span class="project-num">03</span>
      <span class="project-type">Passion Project · January 2026</span>
      <a href="https://potuswatchdaily.com" target="_blank" rel="noopener" class="project-url">potuswatchdaily.com ↗</a>
    </div>
    <div class="project-body">
      <div class="project-browser">
        <div class="browser-bar">
          <span class="bdot r"></span><span class="bdot y"></span><span class="bdot g"></span>
          <span class="burl">potuswatchdaily.com</span>
        </div>
        <a href="https://potuswatchdaily.com" target="_blank" rel="noopener">
          <img src="/portfolio-potus.jpg" alt="POTUS Watch Daily" />
        </a>
      </div>
      <div class="project-info">
        <h2 class="project-title">POTUS Watch Daily</h2>
        <p class="project-desc">Started as practice. Became a real foreign policy intelligence platform that publishes multiple dispatches every single day. Automated content pipeline, breaking news ticker, AdSense, newsletter.</p>
        <div class="project-metrics">
          <div class="metric"><strong>🔁</strong> Publishes multiple times daily</div>
          <div class="metric"><strong>🔴 LIVE</strong> breaking news ticker</div>
          <div class="metric"><strong>💰</strong> AdSense monetised</div>
        </div>
        <div class="project-stack">
          <span>Automated Publishing</span><span>Breaking News</span><span>Newsletter</span><span>AdSense</span><span>SEO</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- MARQUEE -->
<div class="marquee-wrap">
  <div class="marquee-track">
    <span>Web Design</span><span class="mdot">✦</span>
    <span>AI Automation</span><span class="mdot">✦</span>
    <span>SEO</span><span class="mdot">✦</span>
    <span>Email Marketing</span><span class="mdot">✦</span>
    <span>Paid Ads</span><span class="mdot">✦</span>
    <span>Chatbot Setup</span><span class="mdot">✦</span>
    <span>Growth Hacking</span><span class="mdot">✦</span>
    <span>Web Design</span><span class="mdot">✦</span>
    <span>AI Automation</span><span class="mdot">✦</span>
    <span>SEO</span><span class="mdot">✦</span>
    <span>Email Marketing</span><span class="mdot">✦</span>
    <span>Paid Ads</span><span class="mdot">✦</span>
    <span>Chatbot Setup</span><span class="mdot">✦</span>
    <span>Growth Hacking</span><span class="mdot">✦</span>
  </div>
</div>

<!-- SERVICES -->
<section class="services">
  <div class="services-inner">
    <div class="services-top">
      <div>
        <p class="slabel">What I Offer</p>
        <h2 class="services-title">Services</h2>
      </div>
      <a href="/services" class="services-more">Full details →</a>
    </div>
    <div class="sgrid">
      <a href="/services" class="scard scard-lg">
        <span class="scard-icon">💻</span>
        <h3>Web Design & Development</h3>
        <p>Custom sites from scratch. Fast, mobile-first, built to rank. Not templates.</p>
        <span class="scard-arrow">→</span>
      </a>
      <a href="/services" class="scard scard-lg">
        <span class="scard-icon">🤖</span>
        <h3>AI Automation</h3>
        <p>Systems that handle emails, workflows, scheduling automatically.</p>
        <span class="scard-arrow">→</span>
      </a>
      <a href="/services" class="scard">
        <span class="scard-icon">🔍</span>
        <h3>SEO</h3>
        <p>Technical and content SEO so the right people find you.</p>
        <span class="scard-arrow">→</span>
      </a>
      <a href="/services" class="scard">
        <span class="scard-icon">📧</span>
        <h3>Email Marketing</h3>
        <p>Lists, sequences, newsletters, campaigns.</p>
        <span class="scard-arrow">→</span>
      </a>
      <a href="/services" class="scard">
        <span class="scard-icon">📢</span>
        <h3>Paid Ads</h3>
        <p>Facebook, Instagram & Google ads done properly.</p>
        <span class="scard-arrow">→</span>
      </a>
      <a href="/services" class="scard">
        <span class="scard-icon">💬</span>
        <h3>Chatbot Setup</h3>
        <p>AI bots that qualify leads and book 24/7.</p>
        <span class="scard-arrow">→</span>
      </a>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta">
  <div class="cta-inner">
    <p class="cta-eyebrow">Let's build something</p>
    <h2 class="cta-title">Ready when<br/><em>you are.</em></h2>
    <p class="cta-sub">Available for freelance and the right full-time role. You work with me directly — no agency, no handoffs.</p>
    <div class="cta-btns">
      <a href="/contact" class="btn-primary">Get in Touch →</a>
      <a href="/Ubaldo_Resume.docx" download class="btn-secondary">Download Resume</a>
    </div>
  </div>
</section>

</div>
</BaseLayout>

<style>
.portfolio-wrap {
  background: #111;
  min-height: 100vh;
}

/* ── HERO ── */
.hero {
  display: grid;
  grid-template-columns: 1fr 420px;
  grid-template-rows: 1fr auto;
  min-height: calc(100vh - 72px);
  max-width: 1200px;
  margin: 0 auto;
  padding: 60px 40px 0;
  gap: 0 60px;
}
.hero-left {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-bottom: 80px;
}
.hero-available {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: 'Helvetica Neue', sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #4ade80;
  margin-bottom: 2rem;
}
.pulse {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: #4ade80;
  animation: pulse 2s infinite;
}
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }

.hero-name {
  display: flex;
  flex-direction: column;
  line-height: 0.9;
  margin: 0 0 1rem;
}
.hero-name-first {
  font-size: clamp(4rem, 9vw, 8rem);
  font-weight: 900;
  color: var(--cream);
  letter-spacing: -0.02em;
}
.hero-name-last {
  font-size: clamp(4rem, 9vw, 8rem);
  font-weight: 900;
  color: var(--gold);
  letter-spacing: -0.02em;
}
.hero-role {
  font-family: 'Helvetica Neue', sans-serif;
  font-size: 1rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--kraft);
  margin: 0 0 1.25rem;
}
.hero-amp { color: var(--gold); }
.hero-desc {
  font-size: 1rem;
  line-height: 1.8;
  color: var(--kraft);
  max-width: 460px;
  margin-bottom: 2rem;
}
.hero-btns {
  display: flex;
  align-items: center;
  gap: 1.5rem;
}
.hero-cv {
  font-family: 'Helvetica Neue', sans-serif;
  font-size: 13px;
  font-weight: 600;
  color: var(--kraft);
  text-decoration: none;
  transition: color 0.2s;
}
.hero-cv:hover { color: var(--cream); }

.hero-right {
  display: flex;
  align-items: flex-end;
}
.hero-photo-wrap {
  width: 100%;
  max-height: calc(100vh - 160px);
  overflow: hidden;
  border-radius: 16px 16px 0 0;
  background: var(--darkbrown);
}
.hero-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
  filter: contrast(1.05);
}

.hero-stats-bar {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  border-top: 1px solid rgba(196,153,90,0.2);
  padding: 28px 0;
}
.hstat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5px;
}
.hstat-n {
  font-size: 2.2rem;
  font-weight: 900;
  color: var(--gold);
  line-height: 1;
}
.hstat-l {
  font-family: 'Helvetica Neue', sans-serif;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--kraft);
  text-align: center;
}
.hstat-line {
  width: 1px;
  height: 40px;
  background: rgba(196,153,90,0.2);
}

/* ── PROJECTS ── */
.projects {
  max-width: 1200px;
  margin: 0 auto;
  padding: 80px 40px;
}
.projects-label {
  font-family: 'Helvetica Neue', sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.2em;
  color: var(--gold);
  margin-bottom: 3rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid rgba(196,153,90,0.2);
}
.project {
  padding: 60px 0;
  border-bottom: 1px solid rgba(196,153,90,0.12);
}
.project-header {
  display: flex;
  align-items: baseline;
  gap: 1.5rem;
  margin-bottom: 2rem;
}
.project-num {
  font-size: clamp(3.5rem, 7vw, 6rem);
  font-weight: 900;
  color: rgba(196,153,90,0.15);
  line-height: 1;
  letter-spacing: -0.03em;
  flex-shrink: 0;
}
.project-type {
  font-family: 'Helvetica Neue', sans-serif;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--kraft);
  flex: 1;
}
.project-url {
  font-family: 'Helvetica Neue', sans-serif;
  font-size: 13px;
  font-weight: 700;
  color: var(--gold);
  text-decoration: none;
  flex-shrink: 0;
}
.project-url:hover { opacity: 0.7; }
.project-body {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 56px;
  align-items: start;
}
.project-flip .project-body {
  grid-template-columns: 1fr 1.2fr;
}

/* Browser mockup */
.project-browser {
  border-radius: 10px;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,0.08);
  box-shadow: 0 32px 80px rgba(0,0,0,0.6);
  background: #111;
}
.browser-bar {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 10px 14px;
  background: #1e1e1e;
  border-bottom: 1px solid rgba(255,255,255,0.05);
}
.bdot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
.bdot.r { background: #ff5f57; }
.bdot.y { background: #febc2e; }
.bdot.g { background: #28c840; }
.burl {
  flex: 1;
  text-align: center;
  font-family: 'Helvetica Neue', sans-serif;
  font-size: 11px;
  color: rgba(255,255,255,0.3);
  background: rgba(255,255,255,0.05);
  border-radius: 4px;
  padding: 3px 10px;
  margin: 0 6px;
}
.project-browser img {
  width: 100%;
  display: block;
  transition: transform 0.5s ease;
}
.project-browser:hover img { transform: scale(1.02); }

/* Project info */
.project-title {
  font-size: clamp(2rem, 3.5vw, 2.8rem);
  font-weight: 900;
  color: var(--cream);
  margin: 0 0 1rem;
  line-height: 1.05;
}
.project-desc {
  font-size: 15px;
  line-height: 1.8;
  color: var(--kraft);
  margin-bottom: 1.5rem;
}
.project-metrics {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 1.5rem;
  padding: 16px 20px;
  background: rgba(196,153,90,0.05);
  border-left: 2px solid var(--gold);
  border-radius: 0 8px 8px 0;
}
.metric {
  font-family: 'Helvetica Neue', sans-serif;
  font-size: 13px;
  color: var(--kraft);
}
.project-stack {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.project-stack span {
  font-family: 'Helvetica Neue', sans-serif;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.06em;
  padding: 4px 12px;
  border-radius: 20px;
  border: 1px solid rgba(196,153,90,0.25);
  color: rgba(196,153,90,0.8);
}

/* ── MARQUEE ── */
.marquee-wrap {
  overflow: hidden;
  border-top: 1px solid rgba(196,153,90,0.2);
  border-bottom: 1px solid rgba(196,153,90,0.2);
  padding: 20px 0;
  background: var(--darkbrown);
}
.marquee-track {
  display: flex;
  align-items: center;
  gap: 2rem;
  width: max-content;
  animation: marquee 20s linear infinite;
  font-family: 'Helvetica Neue', sans-serif;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--kraft);
}
.mdot { color: var(--gold); }
@keyframes marquee { from{transform:translateX(0)} to{transform:translateX(-50%)} }

/* ── SERVICES ── */
.services {
  padding: 80px 40px;
  max-width: 1200px;
  margin: 0 auto;
}
.services-top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 2.5rem;
}
.slabel {
  font-family: 'Helvetica Neue', sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 6px;
}
.services-title {
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 900;
  color: var(--cream);
  margin: 0;
  line-height: 1;
}
.services-more {
  font-family: 'Helvetica Neue', sans-serif;
  font-size: 13px;
  font-weight: 600;
  color: var(--gold);
  text-decoration: none;
  padding-bottom: 4px;
}
.sgrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  border: 1px solid rgba(196,153,90,0.15);
  border-radius: 12px;
  overflow: hidden;
}
.scard {
  background: rgba(255,255,255,0.02);
  padding: 32px 28px;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  gap: 10px;
  border-right: 1px solid rgba(196,153,90,0.15);
  border-bottom: 1px solid rgba(196,153,90,0.15);
  transition: background 0.25s;
  position: relative;
}
.scard:hover { background: rgba(196,153,90,0.07); }
.scard-icon { font-size: 1.75rem; }
.scard h3 {
  font-size: 1rem;
  font-weight: 700;
  color: var(--cream);
  margin: 0;
}
.scard p {
  font-size: 13px;
  color: var(--kraft);
  line-height: 1.65;
  margin: 0;
  flex: 1;
}
.scard-arrow {
  font-size: 1.1rem;
  color: var(--gold);
  margin-top: auto;
}

/* ── CTA ── */
.cta {
  padding: 120px 40px;
  text-align: center;
  background: var(--darkbrown);
  border-top: 1px solid rgba(196,153,90,0.15);
}
.cta-inner { max-width: 600px; margin: 0 auto; }
.cta-eyebrow {
  font-family: 'Helvetica Neue', sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 1rem;
}
.cta-title {
  font-size: clamp(3rem, 6vw, 5rem);
  font-weight: 900;
  color: var(--cream);
  line-height: 1.05;
  margin: 0 0 1.25rem;
}
.cta-title em { color: var(--gold); font-style: italic; }
.cta-sub {
  font-size: 1rem;
  color: var(--kraft);
  line-height: 1.75;
  margin-bottom: 2.5rem;
}
.cta-btns {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
}

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  .hero { grid-template-columns: 1fr; min-height: auto; padding: 48px 24px 0; }
  .hero-right { order: -1; height: 320px; }
  .hero-photo-wrap { border-radius: 12px; max-height: 320px; }
  .hero-left { padding-bottom: 40px; }
  .hero-stats-bar { flex-wrap: wrap; gap: 1rem; padding: 24px 0; }
  .hstat-line { display: none; }
  .hstat { flex: 0 0 45%; }
  .projects { padding: 60px 24px; }
  .project-body,
  .project-flip .project-body { grid-template-columns: 1fr; gap: 32px; }
  .project-flip .project-body .project-browser { order: -1; }
  .services { padding: 60px 24px; }
  .sgrid { grid-template-columns: 1fr 1fr; }
  .cta { padding: 80px 24px; }
  .services-top { flex-direction: column; align-items: flex-start; gap: 8px; }
}
@media (max-width: 540px) {
  .sgrid { grid-template-columns: 1fr; }
  .hstat { flex: 0 0 100%; }
  .hero-name-first, .hero-name-last { font-size: 3.5rem; }
}
</style>
