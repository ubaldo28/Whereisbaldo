}

#pf-main, #work, #services, #contact { scroll-margin-top: 84px; }

/* ── HERO ── */
.pf-hero {
  position: relative;
  overflow-x: clip;
  min-height: 62vh;
  width: 100%;
  display: flex;
  align-items: flex-start;
  padding-top: 22px;
  background: #fff;
}
.pf-hero-bg {
  position: absolute;
  top: 0; right: 9%;
  width: 44%;
  height: 100%;
  z-index: 1;
}
.pf-hero-bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  display: block;
  filter: grayscale(0.3) contrast(0.85) brightness(1.28) saturate(1.2);
}
.pf-hero-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(to right, #fff 0%, rgba(255,255,255,0.97) 18%, rgba(255,255,255,0.25) 34%, transparent 46%);
}
.pf-hero-text {
  position: relative;
  z-index: 2;
  padding: 0 0 60px 80px;
  max-width: 640px;
}
.pf-available {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #15803d;
  margin-bottom: 1.5rem;
}
.pf-dot {
  width: 8px; height: 8px;
  background: #16a34a;
  border-radius: 50%;
  animation: blink 2s infinite;
}
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.25} }
.pf-h1 {
  font-size: clamp(2.4rem, 4.5vw, 4rem);
  font-weight: 900;
  line-height: 1;
  color: #0a0a0a;
  margin: 0 0 0.25rem;
  letter-spacing: -0.03em;
}
.pf-name {
  display: block;
  font-size: clamp(3rem, 6vw, 5.5rem);
  color: #0a0a0a;
  letter-spacing: -0.04em;
  line-height: 0.95;
}
.pf-redline {
  width: 100%;
  max-width: 560px;
  height: 4px;
  background: #00706e;
  margin: 22px 0;
}
.pf-role {
  font-size: 1rem;
  font-weight: 600;
  color: #5f5f5f;
  margin: 0 0 1rem;
  letter-spacing: 0.02em;
}
.pf-typed {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.05em;
  color: #5f5f5f;
  margin: 0 0 2rem;
  font-family: monospace;
}
.pf-hash { color: #00706e; margin-right: 4px; }
#pf-tw {
  color: #0a0a0a;
  border-right: 2px solid #0a0a0a;
  padding-right: 2px;
  animation: blink-cursor 0.75s step-end infinite;
}
@keyframes blink-cursor { 0%,100%{border-color:#0a0a0a} 50%{border-color:transparent} }
.pf-desc {
  font-size: 1rem;
  line-height: 1.8;
  color: #4f4f4f;
  max-width: 480px;
  margin-bottom: 2rem;
}
.pf-btns { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
.pf-btn {
  display: inline-block;
  background: #0a0a0a;
  color: #fff;
  text-decoration: none;
  padding: 13px 26px;
  font-weight: 700;
  font-size: 14px;
  letter-spacing: 0.02em;
  border: 2px solid #0a0a0a;
  transition: all 0.2s;
}
.pf-btn:hover { background: #fff; color: #0a0a0a; }
.pf-btn-ghost {
  display: inline-block;
  color: #0a0a0a;
  text-decoration: none;
  font-size: 14px;
  font-weight: 600;
  border: 2px solid #0a0a0a;
  padding: 13px 26px;
  background: transparent;
  transition: all 0.2s;
}
.pf-btn-ghost:hover { background: #0a0a0a; color: #fff; }

/* ── TECH STRIP ── */
.pf-tech-strip {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 0.4rem 0;
  margin-top: 2rem;
  padding-top: 1.5rem;
  border-top: 1px solid #e5e5e5;
}
.pf-tech-strip span {
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #5f5f5f;
}
.pf-strip-dot { color: #00706e; padding: 0 0.5rem; }

/* ── HERO STATS ── */
.pf-hero-stats {
  position: absolute;
  right: 64px;
  bottom: 64px;
  z-index: 3;
  display: flex;
  flex-direction: column;
  gap: 0;
  text-align: right;
}
.pf-stat { padding: 6px 0; }
.pf-stat-num {
  display: block;
  font-size: 3.8rem;
  font-weight: 900;
  color: #8a8a8a;
  line-height: 1;
  letter-spacing: -0.05em;
}
.pf-stat-label {
  display: block;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #5f5f5f;
  margin-top: 0;
}
.pf-stat-sep { width: 100%; height: 1px; background: #e5e5e5; }

/* ── CAPABILITIES ── */
.pf-about {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 16px;
  max-width: 1300px;
  margin: 0 auto;
  padding: 56px 60px;
  border-top: 4px solid #0a0a0a;
}
.pf-caps { display: flex; flex-direction: column; gap: 12px; }
.pf-cap {
  background: #fff;
  padding: 24px 24px 20px 28px;
  flex: 1;
  position: relative;
  border: 1.5px solid #e5e5e5;
  transition: border-color 0.2s;
}
.pf-cap::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 4px; height: 100%;
  background: #00706e;
}
.pf-cap:hover { border-color: #0a0a0a; }
.pf-cap-num {
  display: block;
  font-size: 10px;
  font-family: monospace;
  color: #00706e;
  letter-spacing: 0.08em;
  margin-bottom: 10px;
  font-weight: 700;
  text-transform: uppercase;
}
.pf-cap-title {
  font-size: 1.2rem;
  font-weight: 800;
  color: #0a0a0a;
  letter-spacing: -0.02em;
  line-height: 1.2;
  margin: 0 0 8px;
}
.pf-cap-desc {
  font-size: 13px;
  color: #5f5f5f;
  line-height: 1.7;
  margin: 0 0 14px;
}
.pf-cap-tags { display: flex; flex-wrap: wrap; gap: 5px; }
.pf-cap-tags span {
  font-size: 10px;
  font-family: monospace;
  color: #4a4a4a;
  background: #f5f5f5;
  border: 1px solid #e0e0e0;
  padding: 3px 8px;
  border-radius: 2px;
}

/* Credentials + stack */
.pf-cred-col { display: flex; flex-direction: column; gap: 12px; }
.pf-cred-box, .pf-stack-box {
  background: #fff;
  border: 1.5px solid #e5e5e5;
  padding: 22px;
}
.pf-cred-head, .pf-stack-head {
  font-size: 9.5px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #5f5f5f;
  margin: 0 0 14px;
}
.pf-cred-row {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 9px 0;
  border-bottom: 1px solid #f0f0f0;
  font-size: 13px;
  color: #555;
  line-height: 1.5;
}
.pf-cred-row:last-child { border-bottom: none; padding-bottom: 0; }
.pf-cred-row:first-of-type { padding-top: 0; }
.pf-cred-row strong { color: #0a0a0a; font-weight: 700; }
.pf-cred-muted { color: #5f5f5f !important; font-style: italic; }
.pf-dot-g {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: #16a34a;
  flex-shrink: 0;
  margin-top: 5px;
}
.pf-dot-dim {
  width: 6px; height: 6px;
  border-radius: 50%;
  border: 1px solid #ddd;
  flex-shrink: 0;
  margin-top: 5px;
}
.pf-stack-box { flex: 1; }
.pf-stack-group { margin-bottom: 14px; }
.pf-stack-group:last-child { margin-bottom: 0; }
.pf-stack-cat {
  font-size: 9px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #5f5f5f;
  margin: 0 0 7px;
}
.pf-pills { display: flex; flex-wrap: wrap; gap: 5px; }
.pf-pills span {
  font-size: 11px;
  font-family: monospace;
  color: #545454;
  background: #f5f5f5;
  border: 1px solid #e5e5e5;
  padding: 3px 10px;
  border-radius: 100px;
}
.pf-pills span.hi {
  color: #0a0a0a;
  border-color: #0a0a0a;
  background: #fff;
  font-weight: 700;
}

/* ── AVAILABLE BANNER ── */
.pf-avail-banner {
  background: #0a0a0a;
  padding: 18px 60px;
}
.pf-avail-inner {
  max-width: 1300px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 1rem;
}
.pf-avail-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: #4ade80;
  flex-shrink: 0;
  animation: blink 2s infinite;
  box-shadow: 0 0 8px rgba(74,222,128,0.7);
}
.pf-avail-text {
  font-size: 13px;
  font-weight: 500;
  color: rgba(255,255,255,0.62);
  flex: 1;
}
.pf-avail-cta {
  font-size: 12px;
  font-weight: 700;
  color: #fff;
  text-decoration: none;
  border-bottom: 1px solid rgba(255,255,255,0.5);
  display: inline-flex;
  align-items: center;
  min-height: 24px;
  flex-shrink: 0;
  transition: opacity 0.2s;
}
.pf-avail-cta:hover { opacity: 0.7; }

/* ── SECTION LABELS ── */
.pf-label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  margin-bottom: 1rem;
  color: #00706e;
  display: inline-block;
}
.pf-label-inv { color: rgba(255,255,255,0.6) !important; }

/* ── WORK ── */
.pf-work {
  max-width: 1300px;
  margin: 0 auto;
  padding: 100px 60px;
}
.pf-work-title {
  font-size: clamp(3rem, 6vw, 5.5rem);
  font-weight: 900;
  color: #0a0a0a;
  line-height: 1;
  margin: 0 0 60px;
  letter-spacing: -0.05em;
}
.pf-work-dot { color: #00706e; }
.pf-stack {
  font-size: 0.82rem;
  line-height: 1.75;
  margin: 1.1rem 0 1.25rem;
  opacity: 0.75;
  letter-spacing: 0.01em;
}
.pf-stack strong {
  display: block;
  font-size: 0.66rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  opacity: 0.85;
  margin-bottom: 0.3rem;
}
.pf-outcome {
  font-size: 0.95rem;
  line-height: 1.7;
  margin: 0 0 1rem;
  opacity: 0.85;
}
.pf-work-cta {
  margin-top: 3rem;
  padding-top: 2.5rem;
  border-top: 1px solid currentColor;
  border-top-color: color-mix(in srgb, currentColor 14%, transparent);
  text-align: center;
}
.pf-work-cta p {
  font-size: 1.05rem;
  line-height: 1.7;
  max-width: 46ch;
  margin: 0 auto 1.5rem;
}
.pf-project {
  padding: 70px 0;
  border-bottom: 1px solid #e5e5e5;
}
.pf-project-meta {
  display: flex;
  align-items: baseline;
  gap: 1.5rem;
  margin-bottom: 2rem;
}
.pf-num {
  font-size: clamp(3.5rem, 7vw, 6rem);
  font-weight: 900;
  color: #8a8a8a;
  line-height: 1;
  flex-shrink: 0;
  letter-spacing: -0.04em;
}
.pf-tag {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #5f5f5f;
  flex: 1;
}
.pf-link {
  font-size: 13px;
  font-weight: 700;
  color: #00706e;
  text-decoration: none;
  flex-shrink: 0;
  border-bottom: 1px solid rgba(0,112,110,0.4);
  display: inline-flex;
  align-items: center;
  min-height: 24px;
  transition: opacity 0.2s;
}
.pf-link:hover { opacity: 0.7; }
.pf-project-body {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 60px;
  align-items: start;
}
.pf-flip .pf-project-body { grid-template-columns: 1fr 1.2fr; }
.pf-flip .pf-project-meta { flex-direction: row-reverse; }
.pf-flip .pf-tag { text-align: right; }

/* Browser */
.pf-browser {
  border-radius: 6px;
  overflow: hidden;
  border: 1px solid #e0e0e0;
  box-shadow: 0 20px 60px rgba(0,0,0,0.08), 0 4px 16px rgba(0,0,0,0.04);
  background: #f5f5f5;
  transition: box-shadow 0.3s;
}
.pf-browser:hover {
  box-shadow: 0 30px 80px rgba(0,0,0,0.12), 0 8px 24px rgba(0,0,0,0.06);
}
.pf-browser-bar {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 10px 14px;
  background: #1a1a1a;
  border-bottom: 1px solid #111;
}
.bd { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
.bd.r { background: #ff5f57; }
.bd.y { background: #febc2e; }
.bd.g { background: #28c840; }
.burl {
  flex: 1;
  text-align: center;
  font-size: 11px;
  color: rgba(255,255,255,0.55);
  background: rgba(255,255,255,0.06);
  border-radius: 4px;
  padding: 3px 10px;
  margin: 0 6px;
}
.pf-browser img { width: 100%; display: block; transition: transform 0.5s; }
.pf-browser:hover img { transform: scale(1.02); }
.pf-browser-content {
  background: #080d0b;
  position: relative;
  overflow: hidden;
  line-height: 0;
  container-type: inline-size;
  aspect-ratio: 1318/896;
}
.pf-shot-link { display: block; width: 100%; height: 100%; }
/* cover, not stretch — and anchored to the top so the masthead of each
   screenshot is what survives the crop. */
.pf-browser-content img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
}

.pf-vid-overlay {
  position: absolute;
  top: 6.67%; left: 0;
  width: 100%; height: 59.77%;
  object-fit: cover;
  display: block;
  z-index: 0;
  /* GenioTech dims this clip behind their hero text; the knockout removed
     their scrim along with the black, so put the same weight back. */
  filter: brightness(0.46) saturate(0.95);
  transition: transform 0.5s;
}
/* The hero band is knocked out of this screenshot so the clip plays behind the
   site's own text. Dark ground underneath in case the clip never loads. */
.pf-shot-knockout { position: relative; z-index: 1; }
.pf-browser:hover .pf-vid-overlay { transform: scale(1.02); }

/* Project info */
.pf-title {
  font-size: clamp(2rem, 3.5vw, 3rem);
  font-weight: 900;
  color: #0a0a0a;
  margin: 0 0 1rem;
  line-height: 1;
  letter-spacing: -0.04em;
}
.pf-pdesc {
  font-size: 15px;
  line-height: 1.8;
  color: #666;
  margin-bottom: 1.5rem;
}
.pf-metrics {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 1.5rem;
  padding: 16px 20px;
  background: #fafafa;
  border-left: 3px solid #00706e;
  font-size: 13px;
  color: #4f4f4f;
}
.pf-tags { display: flex; flex-wrap: wrap; gap: 6px; }
.pf-tags span {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.06em;
  padding: 4px 12px;
  border: 1px solid #d4d4d4;
  color: #545454;
  background: #fff;
}
.pf-view-btn {
  display: inline-flex;
  align-items: center;
  min-height: 24px;
  margin-top: 1.25rem;
  font-size: 13px;
  font-weight: 700;
  color: #0a0a0a;
  text-decoration: none;
  border-bottom: 2px solid #0a0a0a;
  padding-bottom: 2px;
  transition: color 0.2s, border-color 0.2s;
}
.pf-view-btn:hover { color: #00706e; border-color: #00706e; }


/* ── SERVICES ── */
.pf-services {
  max-width: 1300px;
  margin: 0 auto;
  padding: 100px 60px;
}
.pf-sec-title {
  font-size: clamp(2.5rem, 5vw, 4.5rem);
  font-weight: 900;
  color: #0a0a0a;
  margin: 0 0 2.5rem;
  line-height: 1;
  letter-spacing: -0.05em;
}
.pf-sgrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: #e5e5e5;
  border: 1.5px solid #e5e5e5;
}
.pf-scard {
  background: #fff;
  padding: 36px 30px;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  gap: 10px;
  transition: background 0.2s;
}
.pf-scard:hover { background: #fafafa; }
.pf-scard:hover .pf-sicon { background: #00706e; }
.pf-sicon {
  font-size: 1.3rem;
  width: 44px; height: 44px;
  background: #0a0a0a;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 0.2s;
}
.pf-scard h3 {
  font-size: 1rem;
  font-weight: 800;
  color: #0a0a0a;
  margin: 0;
  letter-spacing: -0.01em;
}
.pf-scard p {
  font-size: 13px;
  color: #5f5f5f;
  line-height: 1.65;
  margin: 0;
}

/* ── CONTACT ── */
.pf-contact {
  padding: 100px 60px;
  background: #0a0a0a;
}
.pf-contact-inner {
  max-width: 1300px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 80px;
  align-items: start;
}
.pf-contact-left { padding-top: 4px; }
.pf-contact-cv { display: inline-block; margin-top: 2rem; }
.pf-contact .pf-btn-ghost {
  color: rgba(255,255,255,0.6);
  border-color: rgba(255,255,255,0.25);
}
.pf-contact .pf-btn-ghost:hover {
  background: #fff;
  color: #0a0a0a;
  border-color: #fff;
}
.pf-cta-title {
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: 900;
  color: #fff;
  line-height: 1.05;
  margin: 0.5rem 0 1.25rem;
  letter-spacing: -0.04em;
}
.pf-cta-title em { color: #2ec4c0; font-style: italic; }
.pf-cta-sub {
  font-size: 1rem;
  color: rgba(255,255,255,0.62);
  line-height: 1.75;
  max-width: 500px;
}
.pf-form { display: flex; flex-direction: column; gap: 20px; }
.pf-form-group { display: flex; flex-direction: column; gap: 8px; }
.pf-form-label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.62);
}
.pf-form-input {
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 0;
  padding: 14px 16px;
  font-size: 14px;
  color: #fff;
  font-family: inherit;
  outline: none;
  transition: border-color 0.2s;
  width: 100%;
}
.pf-form-input::placeholder { color: rgba(255,255,255,0.55); }
.pf-form-input:focus { border-color: #2ec4c0; box-shadow: 0 0 0 2px rgba(46,196,192,0.35); }
.pf-form-textarea { min-height: 140px; resize: vertical; }
.pf-form-submit {
  width: 100%;
  justify-content: center;
  cursor: pointer;
  font-family: inherit;
  font-size: 14px;
  background: #00706e;
  border: 2px solid #00706e;
  color: #fff;
  padding: 13px 26px;
  font-weight: 700;
  letter-spacing: 0.02em;
  transition: all 0.2s;
}
.pf-form-submit:hover { background: transparent; color: #2ec4c0; border-color: #2ec4c0; }
.pf-form-submit:disabled { opacity: 0.6; cursor: default; }

/* ── FOOTER ── */
.pf-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 60px;
  background: #0a0a0a;
  border-top: 1px solid rgba(255,255,255,0.07);
  font-size: 12px;
  color: rgba(255,255,255,0.6);
}
.pf-foot a {
  color: rgba(255,255,255,0.6);
  text-decoration: none;
  transition: color 0.2s;
  display: inline-flex;
  align-items: center;
  min-height: 24px;
}
.pf-foot a:hover { color: rgba(255,255,255,0.6); }
.pf-foot-sites {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 11px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.pf-foot-sep { color: rgba(255,255,255,0.62); }

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
    scroll-behavior: auto !important;
  }
  .pf-dot, .pf-avail-dot { opacity: 1 !important; }
  #pf-tw { border-right-color: transparent; }
}

/* ── RESPONSIVE ── */
