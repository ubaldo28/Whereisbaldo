  line-height: 1.2;
  margin: 0 0 8px;
}
.pf-cap-desc {
  font-size: 12.5px;
  color: rgba(255,255,255,0.38);
  line-height: 1.65;
  margin: 0 0 14px;
}
.pf-cap-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}
.pf-cap-tags span {
  font-size: 10px;
  font-family: monospace;
  color: rgba(255,255,255,0.28);
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.07);
  padding: 3px 8px;
  border-radius: 4px;
}

/* Right: credentials + tech stack */
.pf-cred-col {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.pf-cred-box, .pf-stack-box {
  background: #161616;
  border: 1px solid rgba(255,255,255,0.07);
  border-radius: 10px;
  padding: 20px 22px;
}
.pf-cred-head, .pf-stack-head {
  font-size: 9.5px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.2);
  margin: 0 0 14px;
}
.pf-cred-row {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 9px 0;
  border-bottom: 1px solid rgba(255,255,255,0.05);
  font-size: 13px;
  color: rgba(255,255,255,0.65);
  line-height: 1.5;
}
.pf-cred-row:last-child { border-bottom: none; padding-bottom: 0; }
.pf-cred-row:first-of-type { padding-top: 0; }
.pf-cred-row strong { color: #fff; font-weight: 700; }
.pf-cred-muted { color: rgba(255,255,255,0.28) !important; font-style: italic; }
.pf-dot-g {
  width: 5px; height: 5px;
  border-radius: 50%;
  background: #4ade80;
  flex-shrink: 0;
