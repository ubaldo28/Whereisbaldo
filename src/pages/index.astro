---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = allPosts.slice(0, 6);
---
<BaseLayout>

  <!-- HERO -->
  <section class="hero">
    <button id="install-btn" style="display:none; background:var(--gold); color:var(--dark); border:none; padding:8px 20px; border-radius:20px; font-family:'Helvetica Neue',sans-serif; font-size:12px; font-weight:700; letter-spacing:1px; text-transform:uppercase; cursor:pointer; margin-bottom:1rem;">📲 Get my Free App</button>
    <div id="ios-modal" style="display:none; position:fixed; bottom:0; left:0; right:0; background:var(--darkbrown); color:var(--cream); padding:24px 20px; z-index:999; border-top:2px solid var(--gold); text-align:center; font-family:'Helvetica Neue',sans-serif;">
      <p style="font-size:14px; margin-bottom:12px;">Install my free Where Is Baldo? app — tap <strong>Share ↑</strong> then <strong>"Add to Home Screen"</strong>. No App Store needed.</p>
      <button onclick="document.getElementById('ios-modal').style.display='none'" style="background:var(--orange); color:white; border:none; padding:8px 24px; border-radius:4px; cursor:pointer; font-size:13px;">Got it</button>
    </div>
    <script>
      const btn = document.getElementById('install-btn');
      const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);
      const isStandalone = window.matchMedia('(display-mode: standalone)').matches;
      let deferredPrompt;
      if (!isStandalone) {
        if (isIOS) {
          btn.style.display = 'inline-block';
          btn.addEventListener('click', () => { document.getElementById('ios-modal').style.display = 'block'; });
        }
        window.addEventListener('beforeinstallprompt', (e) => {
          e.preventDefault(); deferredPrompt = e;
          btn.style.display = 'inline-block';
          btn.addEventListener('click', () => { deferredPrompt.prompt(); });
        });
      }
    </script>
    <p class="hero-eyebrow">A California boy. One hell of a story.</p>
    <h1>
      <span class="where">Where</span> <span class="is">Is</span><br />
      <span class="baldo">Baldo</span><span class="q">?</span>
    </h1>
    <div class="hero-buttons">
      <a href="/about" class="btn-primary">Start Here</a>
      <a href="/blog" class="btn-secondary">Read the Blog</a>
    </div>
  </section>


  <!-- TICKER -->
  <div class="ticker">
    <div class="ticker-inner">
      <span class="ticker-item">About Baldo — Coming Soon</span><span class="ticker-dot">✦</span>
      <span class="ticker-item">I'm Being Forced to Self-Deport (Fuck the Home Office) — Coming Soon</span><span class="ticker-dot">✦</span>
      <span class="ticker-item">My Bitch Ass Ex's Sister — Coming Soon</span><span class="ticker-dot">✦</span>
      <span class="ticker-item">Starting Over at 35 — Coming Soon</span><span class="ticker-dot">✦</span>
      <span class="ticker-item">How a California Boy Ended Up in Scotland — Coming Soon</span><span class="ticker-dot">✦</span>
      <span class="ticker-item">Yaspers on the Hilltown — Coming Soon</span><span class="ticker-dot">✦</span>
      <span class="ticker-item">About Baldo — Coming Soon</span><span class="ticker-dot">✦</span>
      <span class="ticker-item">I'm Being Forced to Self-Deport (Fuck the Home Office) — Coming Soon</span><span class="ticker-dot">✦</span>
      <span class="ticker-item">My Bitch Ass Ex's Sister — Coming Soon</span><span class="ticker-dot">✦</span>
      <span class="ticker-item">Starting Over at 35 — Coming Soon</span><span class="ticker-dot">✦</span>
      <span class="ticker-item">How a California Boy Ended Up in Scotland — Coming Soon</span><span class="ticker-dot">✦</span>
      <span class="ticker-item">Yaspers on the Hilltown — Coming Soon</span><span class="ticker-dot">✦</span>
    </div>
  </div>

  <!-- RECENT POSTS — only show if there are live posts, otherwise show teaser -->
  {recentPosts.length > 0 ? (
    <section class="posts-section">
      <div class="section-header">
        <div>
          <span class="section-label">Latest Stories</span>
          <h2 class="section-title">The Stories</h2>
        </div>
        <a href="/blog" class="see-all">All Posts →</a>
      </div>
      <div class="posts-grid">
        {recentPosts.map(post => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            slug={post.slug}
            tags={post.data.tags}
            pubDate={post.data.pubDate}
            heroEmoji={post.data.heroEmoji}
            heroColor={post.data.heroColor}
          />
        ))}
      </div>
    </section>
  ) : null}

  <!-- COMING SOON STORIES -->
  <section class="coming-soon-list">
    <span class="section-label">Coming Soon</span>
    <ul>
      <li>About Baldo</li>
      <li>I'm Being Forced to Self-Deport (Fuck the Home Office)</li>
      <li>My Bitch Ass Ex's Sister (How They Want Their Dad Dead to Get the Will)</li>
      <li>Starting Over at 35</li>
      <li>How a California Boy Ended Up in Scotland</li>
      <li>Yaspers on the Hilltown (Barbering in Scotland)</li>
      <li style="font-style:normal; color:var(--brown); font-size:15px; border-bottom:none;">...and more to come.</li>
    </ul>
    <p style="font-size:15px;color:var(--brown);margin-bottom:6px;">Know someone who needs to read this?</p>
    <p style="font-size:13px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--brown);margin-bottom:14px;">Share it:</p>
    <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-bottom:2rem;">
      <!-- Facebook -->
      <a href="https://www.facebook.com/sharer/sharer.php?u=https://whereisbaldo.com" target="_blank" rel="noopener" title="Share on Facebook" style="display:inline-flex;width:42px;height:42px;border-radius:50%;background:#1877F2;color:#fff;align-items:center;justify-content:center;text-decoration:none;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="white"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
      </a>
      <!-- WhatsApp -->
      <a href="https://wa.me/?text=Check%20this%20out%20%E2%80%94%20https://whereisbaldo.com" target="_blank" rel="noopener" title="Share on WhatsApp" style="display:inline-flex;width:42px;height:42px;border-radius:50%;background:#25D366;color:#fff;align-items:center;justify-content:center;text-decoration:none;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
      </a>
      <!-- X/Twitter -->
      <a href="https://twitter.com/intent/tweet?url=https://whereisbaldo.com&text=Where%20Is%20Baldo%3F" target="_blank" rel="noopener" title="Share on X" style="display:inline-flex;width:42px;height:42px;border-radius:50%;background:#000;color:#fff;align-items:center;justify-content:center;text-decoration:none;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="white"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.747l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
      <!-- Telegram -->
      <a href="https://t.me/share/url?url=https://whereisbaldo.com" target="_blank" rel="noopener" title="Share on Telegram" style="display:inline-flex;width:42px;height:42px;border-radius:50%;background:#229ED9;color:#fff;align-items:center;justify-content:center;text-decoration:none;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="white"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
      </a>
      <!-- LinkedIn -->
      <a href="https://www.linkedin.com/sharing/share-offsite/?url=https://whereisbaldo.com" target="_blank" rel="noopener" title="Share on LinkedIn" style="display:inline-flex;width:42px;height:42px;border-radius:50%;background:#0A66C2;color:#fff;align-items:center;justify-content:center;text-decoration:none;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="white"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
      </a>
      <!-- Reddit -->
      <a href="https://reddit.com/submit?url=https://whereisbaldo.com&title=Where%20Is%20Baldo%3F" target="_blank" rel="noopener" title="Share on Reddit" style="display:inline-flex;width:42px;height:42px;border-radius:50%;background:#FF4500;color:#fff;align-items:center;justify-content:center;text-decoration:none;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="white"><circle cx="12" cy="12" r="10"/><path fill="#FF4500" d="M19.59 12c0-.81-.66-1.47-1.47-1.47-.4 0-.76.16-1.02.42-1-.7-2.38-1.15-3.9-1.21l.66-3.11 2.16.46c0 .54.44.97.97.97.54 0 .97-.43.97-.97s-.43-.97-.97-.97c-.38 0-.71.22-.87.54l-2.42-.51c-.06-.01-.12 0-.17.03-.05.03-.08.08-.1.14l-.74 3.47c-1.54.05-2.93.5-3.94 1.21-.26-.26-.63-.42-1.02-.42-.81 0-1.47.66-1.47 1.47 0 .6.36 1.12.88 1.35-.02.15-.03.3-.03.45 0 2.28 2.65 4.13 5.92 4.13s5.92-1.85 5.92-4.13c0-.15-.01-.3-.03-.45.52-.23.88-.75.88-1.35zm-9.35 1.15c-.54 0-.97-.43-.97-.97s.43-.97.97-.97.97.43.97.97-.43.97-.97.97zm5.19 2.58c-.64.64-1.66.95-3.11.95s-2.47-.31-3.11-.95a.27.27 0 0 1 0-.38.27.27 0 0 1 .38 0c.52.52 1.39.77 2.73.77s2.21-.25 2.73-.77a.27.27 0 0 1 .38 0 .27.27 0 0 1 0 .38zm-.19-1.61c-.54 0-.97-.43-.97-.97s.43-.97.97-.97.97.43.97.97-.43.97-.97.97z"/></svg>
      </a>
      <!-- Pinterest -->
      <a href="https://pinterest.com/pin/create/button/?url=https://whereisbaldo.com" target="_blank" rel="noopener" title="Share on Pinterest" style="display:inline-flex;width:42px;height:42px;border-radius:50%;background:#E60023;color:#fff;align-items:center;justify-content:center;text-decoration:none;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="white"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
      </a>
      <!-- Copy Link -->
      <button onclick="navigator.clipboard.writeText('https://whereisbaldo.com').then(()=>{this.setAttribute('title','Copied!');setTimeout(()=>{this.setAttribute('title','Copy Link')},2000)})" title="Copy Link" style="display:inline-flex;width:42px;height:42px;border-radius:50%;background:#4B5563;color:#fff;align-items:center;justify-content:center;border:none;cursor:pointer;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
      </button>
    </div>
<div class="email-signup">
      <p>Get the next story in your inbox.</p>
      <form id="subscribeForm" class="subscribe-form">
        <input type="email" id="subscribeEmail" placeholder="Your email" required />
        <button type="submit">Subscribe</button>
      </form>
      <p id="subscribeMsg" style="display:none; margin-top:10px; font-size:14px; color:var(--brown);"></p>
    </div>

    <div class="app-reminder">
      <p>Don't miss a story. Download the app and turn on notifications.</p>
      <button id="install-btn-2" style="background:var(--gold); color:var(--dark); border:none; padding:10px 24px; border-radius:20px; font-family:'Helvetica Neue',sans-serif; font-size:13px; font-weight:700; letter-spacing:1px; text-transform:uppercase; cursor:pointer;">📲 Get the Free App</button>
      <div id="install-modal" style="display:none; position:fixed; bottom:0; left:0; right:0; background:var(--darkbrown); color:var(--cream); padding:24px 20px; z-index:999; border-top:2px solid var(--gold); text-align:center; font-family:'Helvetica Neue',sans-serif;">
        <p id="install-msg" style="font-size:14px; margin-bottom:12px;"></p>
        <button onclick="document.getElementById('install-modal').style.display='none'" style="background:var(--orange); color:white; border:none; padding:8px 24px; border-radius:4px; cursor:pointer; font-size:13px;">Got it</button>
      </div>
      <script>
        const btn2 = document.getElementById('install-btn-2');
        const modal = document.getElementById('install-modal');
        const msg = document.getElementById('install-msg');
        const isIOS2 = /iphone|ipad|ipod/i.test(navigator.userAgent);
        const isAndroid = /android/i.test(navigator.userAgent);
        const isStandalone2 = window.matchMedia('(display-mode: standalone)').matches;
        let deferredPrompt2;
        window.addEventListener('beforeinstallprompt', (e) => { e.preventDefault(); deferredPrompt2 = e; });
        btn2.addEventListener('click', () => {
          if (isStandalone2) return;
          if (deferredPrompt2) {
            deferredPrompt2.prompt();
          } else if (isIOS2) {
            msg.innerHTML = 'Tap <strong>Share ↑</strong> then <strong>"Add to Home Screen"</strong> — free, no App Store needed.';
            modal.style.display = 'block';
          } else {
            msg.innerHTML = 'Open your browser menu and tap <strong>"Add to Home Screen"</strong> or <strong>"Install App"</strong> — free, no App Store needed.';
            modal.style.display = 'block';
          }
        });
      </script>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="about-strip">
    <div class="about-inner">
      <div class="about-avatar">✂️</div>
      <div class="about-text">
        <span class="section-label" style="color:var(--gold)">Who Is Baldo?</span>
        <h2>California born.<br />Mexican roots.<br /><span>Starting over.</span></h2>
        <a href="/about" class="btn-primary">Read My Story</a>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="services-section">
    <div class="services-inner">
      <span class="section-label">What I Do</span>
      <h2 class="section-title">Beyond the Blog</h2>
      <p class="services-intro">I also build websites and set up AI automation for small businesses and creators. You're looking at one of them right now.</p>
      <div class="services-grid">
        <div class="service-card">
          <div class="service-icon">💻</div>
          <h3>Web Design & Development</h3>
          <p>Fast, custom-built sites that look good on every device and actually do what they're supposed to. Not templates. Real builds.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">🤖</div>
          <h3>AI Automation</h3>
          <p>Repetitive tasks that eat your time don't have to. I set up systems that handle emails, workflows, content scheduling and more — automatically.</p>
        </div>
      </div>
      <a href="/work-with-me" class="btn-primary" style="margin-top:2rem;display:inline-block;">Work With Me →</a>
    </div>
  </section>

  <!-- TACO -->
  <section class="taco-section">
    <h2>Buy Baldo a Taco 🌮</h2>
    <a href="https://buymeacoffee.com/whereisbaldo" class="btn-primary" target="_blank" rel="noopener">Buy Baldo a Taco</a>
  </section>

<script>
  const form = document.getElementById('subscribeForm');
  const msg = document.getElementById('subscribeMsg');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = document.getElementById('subscribeEmail').value;
    const btn = form.querySelector('button');
    btn.textContent = 'Subscribing...';
    btn.disabled = true;
    try {
      const res = await fetch('/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = await res.json();
      msg.style.display = 'block';
      if (data.success) {
        msg.textContent = "You're in. Next story goes straight to your inbox.";
        form.reset();
      } else {
        msg.textContent = data.error || 'Something went wrong. Try again.';
      }
    } catch {
      msg.textContent = 'Something went wrong. Try again.';
    }
    btn.textContent = 'Subscribe';
    btn.disabled = false;
  });
</script>

</BaseLayout>
