---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found — Where Is Baldo?" description="This page doesn't exist. Much like Baldo's plans.">
  <section style="text-align:center; padding: 6rem 2rem; max-width: 600px; margin: 0 auto;">
    <div style="font-size: 4rem; margin-bottom: 1rem;">🧭</div>
    <span class="section-label">404</span>
    <h1 style="font-size: clamp(2rem, 5vw, 3rem); margin: 0.5rem 0 1rem;">Page Not Found</h1>
    <p style="color: var(--brown); font-size: 1.1rem; line-height: 1.7; margin-bottom: 2rem;">
      Even Baldo doesn't know where this page went. Possibly Albania.
    </p>
    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <a href="/" class="btn-primary">← Back Home</a>
      <a href="/blog" class="btn-secondary">Read the Blog</a>
    </div>
  </section>
</BaseLayout>
