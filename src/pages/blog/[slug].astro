---
import PostLayout from '../../layouts/PostLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);

// Related posts: same tags, excluding current
const related = allPosts
  .filter(p => p.id !== post.id && (p.data.tags || []).some(t => (post.data.tags || []).includes(t)))
  .slice(0, 3);
---
<PostLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  tags={post.data.tags}
  heroEmoji={post.data.heroEmoji}
  heroColor={post.data.heroColor}
  ogImage={post.data.ogImage ?? `/og/${post.id}.png`}
  relatedPosts={related}
>
  <Content />
</PostLayout>
