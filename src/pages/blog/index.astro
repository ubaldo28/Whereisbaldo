---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Blog — Where Is Baldo?" description="Real stories from a California boy who moved to Scotland, watched his life fall apart, and started writing about it. This is the honest version.">

  <section class="page-header">
    <span class="section-label">All Stories</span>
    <h1>The Blog</h1>
    <p class="page-subtitle">Every story here is real.</p>
  </section>

  <section class="posts-section" style="padding-top: 0;">
    <div class="posts-grid">
      {allPosts.map(post => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          slug={post.id}
          tags={post.data.tags}
          pubDate={post.data.pubDate}
          heroEmoji={post.data.heroEmoji}
          heroColor={post.data.heroColor}
          heroImage={post.data.heroImage}
          heroAlt={post.data.heroAlt}
        />
      ))}
    </div>
    {allPosts.length === 0 && (
      <div class="empty-state">
        <p>Stories are coming. First one drops soon.</p>
      </div>
    )}
  </section>

</BaseLayout>

<style>
  .page-header {
    padding: 4rem 2rem 3rem;
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }
  .page-header h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin: 0.5rem 0 1rem;
    color: var(--dark);
  }
  .page-subtitle {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--brown);
    max-width: 600px;
    margin: 0 auto;
  }
  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--brown);
    font-style: italic;
    font-size: 1.1rem;
  }
</style>
