  <section style="text-align:center; padding: 6rem 2rem; max-width: 600px; margin: 0 auto;">
    <div style="font-size: 4rem; margin-bottom: 1rem;">📖</div>
    <span class="section-label">The Real Story</span>
    <h1 style="font-size: clamp(2rem, 5vw, 3rem); margin: 0.5rem 0 1rem;">Coming Soon</h1>
    <p style="color: var(--brown); font-size: 1.1rem; line-height: 1.7; margin-bottom: 2rem;">
      This one takes a minute to tell properly. Check back soon.
    </p>
    <a href="/" class="btn-primary">← Back Home</a>
  </section>
</BaseLayout>
